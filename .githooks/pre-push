#!/usr/bin/env bash
# .githooks/pre-push — R369: delegate to scripts/gates/pre-push-guard.sh
# (the size gate against the remote tip this push updates).
# Enable once per clone:  git config core.hooksPath .githooks
# (config is not tracked; each worktree/clone opts in with that one line).
exec bash "$(git rev-parse --show-toplevel)/scripts/gates/pre-push-guard.sh"
