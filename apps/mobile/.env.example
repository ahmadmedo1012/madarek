# مدارك موبايل — environment template (copy to .env; never commit real .env files)
# The API base URL is PUBLIC configuration — it is safe to expose and is baked
# into the app bundle at build time. Secrets (tokens, keys) never go here.
EXPO_PUBLIC_API_BASE_URL=https://madarek.onrender.com/api/v1

# EXPO_TOKEN is NOT an app variable. It authenticates the EAS CLI only and must
# be provided through the CI/EAS environment — never through EXPO_PUBLIC_*.
