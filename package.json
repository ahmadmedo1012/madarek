{
  "name": "madarek",
  "version": "1.0.0",
  "private": true,
  "description": "مدارك — منصّة تعليم ذكي مستقلّة عربية-أولًا · Madarek — an independent Arabic-first smart-learning platform.",
  "engines": {
    "node": ">=20 <25"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "preinstall": "node scripts/warn-node-env.mjs",
    "build": "npm run build -w frontend && npm run build -w backend && npm run db:deploy && npm run db:seed",
    "start": "node backend/dist/index.js",
    "dev": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "dev:full": "node scripts/r319/dev-full.mjs",
    "db:local": "node scripts/r319/local-db.mjs",
    "test": "npm run test -w frontend && npm run test -w backend",
    "test:integration": "npm run test:integration -w backend",
    "lint": "eslint frontend/src backend/src",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend && npm run typecheck:tests -w backend && npm run typecheck:tests -w frontend",
    "db:migrate": "npm run prisma:migrate -w backend",
    "db:deploy": "npm run prisma:deploy -w backend",
    "db:seed": "npm run prisma:seed -w backend",
    "db:seed:force": "MADAREK_SEED_FORCE=1 npm run db:seed",
    "db:rotate-password": "npm run rotate:password -w backend --",
    "db:provision-owner": "npm run provision:owner -w backend --",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "smoke": "node scripts/smoke-deploy.mjs",
    "validate:colleges": "tsx scripts/validate-college-identity.ts",
    "check:motion-tokens": "bash scripts/check-motion-tokens.sh",
    "check:icons": "bash scripts/check-icons.sh",
    "check:colors": "bash scripts/check-colors.sh",
    "check:raw-css": "bash scripts/check-raw-css.sh",
    "check:csp-hash": "bash scripts/check-csp-hash.sh",
    "gate:r318": "node scripts/r318/defect-gate.mjs",
    "gate:r319": "node scripts/r319/gate.mjs",
    "gate:r320": "node scripts/r320/gate.mjs",
    "lint:r320": "node scripts/r320/duplicate-selector-lint.mjs && node scripts/r320/hover-guard-lint.mjs",
    "db:verify": "node scripts/db-verify.mjs"
  },
  "prepare": "git config core.hooksPath .githooks",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "clipper-lib": "^6.4.2",
    "embedded-postgres": "^16.14.0-beta.17",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "harfbuzzjs": "^1.6.4",
    "opentype.js": "^2.0.0",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.71.1"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "argon2": true,
    "esbuild": true,
    "@embedded-postgres/linux-x64": true
  }
}
