{
  "name": "zu-platform",
  "version": "1.0.0",
  "private": true,
  "description": "منصة جامعة الزاوية للتعليم الذكي — Arabic-RTL learning platform for University of Zawia (Ministry of Higher Education, Libya).",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build -w frontend && npm run build -w backend && npm run db:deploy",
    "start": "node backend/dist/index.js",
    "dev": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "test": "npm run test -w frontend && npm run test -w backend",
    "db:migrate": "npm run prisma:migrate -w backend",
    "db:deploy": "npm run prisma:deploy -w backend",
    "db:seed": "npm run prisma:seed -w backend",
    "validate:colleges": "tsx scripts/validate-college-identity.ts",
    "check:motion-tokens": "bash scripts/check-motion-tokens.sh",
    "check:icons": "bash scripts/check-icons.sh",
    "check:i18n": "bash scripts/check-i18n-coverage.sh"
  },
  "devDependencies": {
    "prisma": "^7.8.0",
    "tsx": "^4.22.4"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  }
}
