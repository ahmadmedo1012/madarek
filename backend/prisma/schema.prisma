  @@index([userId])
  @@index([labId])
}

model ArExperience {
  id          String           @id @default(cuid())
  title       String
  subject     String
  type        ArExperienceType
  description String?
  iconEmoji   String?
  themeColor  String?
  contentUrl  String?
  createdAt   DateTime         @default(now())
}

// ────────────────────────────────────────────────────────────────
//  AI conversations
// ────────────────────────────────────────────────────────────────
model AiConversation {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title         String?
  createdAt     DateTime    @default(now())
  messages      AiMessage[]

  @@index([userId])
  // r179 (phase-5): conversations are institution-scoped — history,
  // append, and delete all filter by the caller's verified context.
  @@index([userId, institutionId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiMessageRole
  content        String
  tokens         Int            @default(0)
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

// ────────────────────────────────────────────────────────────────
//  Audit log
// ────────────────────────────────────────────────────────────────
model AuditLog {
  id            String       @id @default(cuid())
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  // r178: NULL = platform-scope entry; non-null = institution-scope
  // (owner mutations on institutions carry it).
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  action        String
  resourceType  String?
  resourceId    String?
  ip            String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@index([institutionId])
}

// ════════════════════════════════════════════════════════════════
//  Flipped Classroom — Lectures, Chapters, Checkpoints
//  Each lecture is a video + chaptered transcript + mid-video
//  checkpoints. Watch events feed the knowledge-tracing model.
// ════════════════════════════════════════════════════════════════

model Lecture {
  id               String           @id @default(cuid())
  offeringId       String
  offering         CourseOffering   @relation(fields: [offeringId], references: [id])
  title            String
  description      String?
  ordinal          Int              @default(0)
  durationSec      Int              @default(0)
  videoUrl         String
  posterUrl        String?
  transcriptUrl    String?
  // r323 B2.3 — the STT job ledger (the upload path writes DONE directly;
  // the generation path walks QUEUED → RUNNING → DONE|FAILED).
  transcriptStatus TranscriptStatus @default(NONE)
  transcriptError  String?
  createdAt        DateTime         @default(now())

  chapters    LectureChapter[]
  checkpoints LectureCheckpoint[]
  watchEvents WatchEvent[]

  @@index([offeringId, ordinal])
}

model LectureChapter {
  id        String            @id @default(cuid())
  lectureId String
  lecture   Lecture           @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  title     String
  startSec  Int
  endSec    Int
  ordinal   Int               @default(0)
  conceptId String?
  concept   KnowledgeConcept? @relation(fields: [conceptId], references: [id])

  @@index([lectureId])
  @@index([conceptId])
}

model LectureCheckpoint {
  id           String             @id @default(cuid())
  lectureId    String
  lecture      Lecture            @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  conceptId    String?
  concept      KnowledgeConcept?  @relation(fields: [conceptId], references: [id])
  triggerSec   Int
  question     String
  options      Json
  correctIndex Int
  explanation  String?
  // r157 (W2-F7 / audit 6A5): the student's per-checkpoint answer memory
  // (one row per student+checkpoint). Cascade — deleting a checkpoint
  // (or its lecture) takes its answers with it.
  answers      CheckpointAnswer[]

  @@index([lectureId])
  @@index([conceptId])
}

// r157 (W2-F7 / audit 6A5): server memory for checkpoint answers.
// Checkpoints had NO persisted answer: every page reload re-fired every
// quiz, and re-answering burned the r155a MASTERY_ATTEMPT_CAP (a
// student who reloaded 4 times could no longer move their mastery
// while the checkpoints kept quizzing). One row per (student,
// checkpoint) — unique below — upserted by the answer route (last
// answer wins) and projected back as bare checkpointIds by
// GET /lectures/:id so the player can seed answeredCheckpointIds.
// answerIndex/correct never travel to the wire (privacy of attempts).
model CheckpointAnswer {
  id           String            @id @default(cuid())
  checkpointId String
  checkpoint   LectureCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  studentId    String
  student      User              @relation("StudentCheckpointAnswers", fields: [studentId], references: [id], onDelete: Cascade)
  // The LAST answer (upsert semantics — a re-answer overwrites).
  answerIndex  Int
  correct      Boolean
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([checkpointId, studentId])
  @@index([studentId])
}

model WatchEvent {
  id         String   @id @default(cuid())
  lectureId  String
  lecture    Lecture  @relation(fields: [lectureId], references: [id])
  studentId  String
  student    User     @relation("StudentWatchEvents", fields: [studentId], references: [id])
  watchedSec Int
  totalSec   Int
  completed  Boolean  @default(false)
  replays    Int      @default(0)
  lastSeenAt DateTime @default(now())

  @@unique([lectureId, studentId])
  @@index([studentId])
}

// ════════════════════════════════════════════════════════════════
//  Educational Matrix — concepts, mastery, gap-detection
// ════════════════════════════════════════════════════════════════

model KnowledgeConcept {
  id       String             @id @default(cuid())
  courseId String
  course   Course             @relation(fields: [courseId], references: [id])
  name     String
  parentId String?
  parent   KnowledgeConcept?  @relation("ConceptTree", fields: [parentId], references: [id])
  children KnowledgeConcept[] @relation("ConceptTree")
  ordinal  Int                @default(0)

  chapters    LectureChapter[]
  checkpoints LectureCheckpoint[]
  masteries   StudentMastery[]

  @@index([courseId])
  @@index([parentId])
}

model StudentMastery {
  id            String           @id @default(cuid())
  studentId     String
  student       User             @relation("StudentMasteries", fields: [studentId], references: [id])
  conceptId     String
  concept       KnowledgeConcept @relation(fields: [conceptId], references: [id])
  level         Decimal          @db.Decimal(4, 3) // 0.000 — 1.000
  attempts      Int              @default(0)
  correct       Int              @default(0)
  lastUpdatedAt DateTime         @default(now())

  @@unique([studentId, conceptId])
  @@index([conceptId])
}

// ════════════════════════════════════════════════════════════════
//  Research Papers workflow
//  Upload → simulated plagiarism + AI-detection → professor grade
// ════════════════════════════════════════════════════════════════

enum ResearchPaperStatus {
  UPLOADED
  SCANNING
  CHECKS_PASSED
  CHECKS_FAILED
  GRADED
  PUBLISHED
}

model ResearchPaper {
  id            String              @id @default(cuid())
  studentId     String
  student       User                @relation("StudentPapers", fields: [studentId], references: [id])
  reviewerId    String?
  reviewer      User?               @relation("ProfessorReviewedPapers", fields: [reviewerId], references: [id])
  offeringId    String?
  offering      CourseOffering?     @relation(fields: [offeringId], references: [id])
  /// r179 (phase-5): the institution the paper was submitted under —
  /// the membership context of the submission (a user may hold student
  /// profiles in several institutions).
  institutionId String
  institution   Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title         String
  abstract      String?
  fileUrl       String?
  status        ResearchPaperStatus @default(UPLOADED)
  plagiarismPct Decimal?            @db.Decimal(4, 1)
  aiContentPct  Decimal?            @db.Decimal(4, 1)
  grade         Decimal?            @db.Decimal(4, 1)
  feedback      String?
  uploadedAt    DateTime            @default(now())
  scannedAt     DateTime?
  gradedAt      DateTime?
  publishedAt   DateTime?
  extractedText String?             @db.Text
  annotations   PaperAnnotation[]

  @@index([studentId])
  @@index([reviewerId])
  @@index([status])
  @@index([offeringId])
  // r180: the phase-5 migration already created this index in SQL
  // (20261018000000: ResearchPaper_institutionId_idx) — the model
  // declaration was missing, so the next `prisma migrate dev` would
  // have generated a DROP of the exact index the institution-scoped
  // paper queues/lists rely on (schema↔DB drift closed, no migration
  // needed — the database already has it).
  @@index([institutionId])
}

// Inline feedback on a research paper. Teachers/reviewers leave page-anchored
// comments; the student sees them when reading the graded paper.
model PaperAnnotation {
  id        String        @id @default(cuid())
  paperId   String
  paper     ResearchPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  page      Int // 1-indexed PDF page
  comment   String        @db.Text
  color     String? // hex like "#F5A623" — UI tint; null → default
  createdAt DateTime      @default(now())

  @@index([paperId])
  @@index([authorId])
}

// ────────────────────────────────────────────────────────────────
//  Training tracks & rewards (Self-Development module)
// ────────────────────────────────────────────────────────────────
//  TrainingTrack       a self-contained learning path (e.g. "Research Skills")
//  TrainingLesson      ordered lessons inside a track, optional check-question
//  TrainingEnrollment  student joins a track
//  LessonProgress      one row per completed lesson per enrollment
//  Badge / UserBadge   visual milestones (per-track + cross-cutting)
//  PointsLedger        append-only audit of every point award
// ────────────────────────────────────────────────────────────────

enum TrainingTrackCategory {
  ONBOARDING
  ACADEMIC
  FLIPPED
  STUDY_SKILLS
  RESEARCH
  CAREER
  COMMUNICATION
  ENGLISH
  PROGRAMMING
  PRODUCTIVITY
  VISION
}

model TrainingTrack {
  id          String                @id @default(cuid())
  slug        String                @unique
  title       String
  titleEn     String?
  summary     String                @db.Text
  category    TrainingTrackCategory
  level       String                @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  iconEmoji   String?
  themeColor  String?
  estMinutes  Int                   @default(60)
  pointsAward Int                   @default(200)
  order       Int                   @default(0)
  isPublished Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  lessons      TrainingLesson[]
  enrollments  TrainingEnrollment[]
  badges       Badge[]
  certificates Certificate[]

  @@index([category])
  @@index([order])
}

model TrainingLesson {
  id              String        @id @default(cuid())
  trackId         String
  track           TrainingTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  order           Int
  title           String
  summary         String?
  contentMarkdown String        @db.Text
  estMinutes      Int           @default(8)
  pointsAward     Int           @default(5)
  quizQuestion    String?
  quizAnswer      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  progresses LessonProgress[]

  @@unique([trackId, order])
  @@index([trackId])
}

model TrainingEnrollment {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  trackId     String
  track       TrainingTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  startedAt   DateTime      @default(now())
  completedAt DateTime?

  progresses LessonProgress[]

  @@unique([userId, trackId])
  @@index([trackId])
}

model LessonProgress {
  id            String             @id @default(cuid())
  enrollmentId  String
  enrollment    TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId      String
  lesson        TrainingLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt   DateTime           @default(now())
  pointsAwarded Int                @default(0)

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
}

model Badge {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String
  iconEmoji   String
  themeColor  String?
  rarity      String         @default("COMMON") // COMMON | RARE | EPIC | LEGENDARY
  trackId     String?
  track       TrainingTrack? @relation(fields: [trackId], references: [id])
  createdAt   DateTime       @default(now())

  users UserBadge[]

  @@index([trackId])
}

model UserBadge {
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now())

  @@id([userId, badgeId])
  // r146 (T1-c F3): FK badgeId is ON DELETE RESTRICT with no index —
  // deleting a Badge scan-joins UserBadge; the PK (userId, badgeId)
  // does NOT cover badgeId. Same gap class the 20260924000000
  // hardening round closed for the sibling FKs.
  @@index([badgeId])
}

model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int
  reason    String
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ════════════════════════════════════════════════════════════════
//  Governance: capabilities + role/user permissions
// ════════════════════════════════════════════════════════════════
//  Two-layer model:
//    1. RolePermission — defaults granted by Role
//    2. UserPermission — explicit overrides per user (grant or revoke)
//
//  Effective caps = (RolePermission for user.role) ∪ (UserPermission grants)
//                   ∖ (UserPermission revokes)
// ────────────────────────────────────────────────────────────────

model RolePermission {
  role       Role
  capability Capability

  @@id([role, capability])
}

model UserPermission {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation("UserPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  capability    Capability
  // r178: NULL = platform-global grant (applies in every institution);
  // non-null = institution-scoped grant. Postgres treats NULLs as
  // distinct in the composite unique below — app code upserts on the
  // triple.
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  // grant=true means this cap is explicitly given even if role doesn't have it.
  // grant=false means this cap is explicitly revoked even if role has it.
  grant         Boolean      @default(true)
  grantedAt     DateTime     @default(now())
  grantedById   String?
  grantedBy     User?        @relation("UserPermissionGranter", fields: [grantedById], references: [id])
  reason        String?

  @@unique([userId, capability, institutionId])
  // r146 (T1-c F3): FK grantedById is ON DELETE SET NULL with no index
  // — deleting a granter User scan-joins this table; the unique
  // (userId, capability, institutionId) does not cover grantedById.
  @@index([grantedById])
}

