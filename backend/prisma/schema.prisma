// ════════════════════════════════════════════════════════════════
//  Madarek AI — Prisma schema (PostgreSQL)
// ════════════════════════════════════════════════════════════════
//  Models the full domain extracted from the prototype:
//  users + role profiles, faculties, departments, courses,
//  offerings, enrollments, schedule, attendance, grades,
//  assignments, materials, messages, notifications, posts,
//  library/loans, MOOCs, jobs, achievements, skills,
//  virtual labs, AR experiences, AI conversations, audit log.
// ────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Note: providers like Neon support pooled & direct connection strings.
  // For this project we use a single Neon "pooler" URL that works for both
  // runtime queries and `prisma migrate`. If you ever need to split them,
  // re-enable directUrl below and set DIRECT_DATABASE_URL to the unpooled host.
  // directUrl = env("DIRECT_DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────
//  Enums
// ────────────────────────────────────────────────────────────────
enum Role {
  STUDENT
  TEACHER
  ADMIN
  QUALITY
}

enum AcademicRank {
  LECTURER
  ASSISTANT_PROFESSOR
  ASSOCIATE_PROFESSOR
  PROFESSOR
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum AssignmentType {
  HOMEWORK
  QUIZ
  PROJECT
  EXAM
}

enum GradeKind {
  HOMEWORK
  QUIZ_1
  QUIZ_2
  MIDTERM
  PROJECT
  FINAL
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  RETURNED
  LATE
}

enum NotificationType {
  URGENT
  ACADEMIC
  SYSTEM
  SOCIAL
}

enum MaterialType {
  PDF
  PPT
  VIDEO
  DOC
  ZIP
  IMAGE
  OTHER
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  FREELANCE
  REMOTE
}

enum JobApplicationStatus {
  APPLIED
  REVIEWED
  SHORTLISTED
  REJECTED
  HIRED
}

enum CertificateStatus {
  ONGOING
  COMPLETED
  EXPIRED
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

enum ArExperienceType {
  AR
  VR
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ─── Phase: governance + exams + social ─────────────────────────
enum DegreeLevel {
  BACHELORS
  MASTERS
  PHD
}

enum Capability {
  // Research
  RESEARCH_GRADE_OWN      // grade papers in offerings I teach
  RESEARCH_GRADE_ANY      // grade any paper (admin override)
  RESEARCH_PUBLISH        // publish to library
  // Exams
  EXAMS_AUTHOR            // create exam templates + questions
  EXAMS_MODERATE          // approve / reject exam templates
  EXAMS_TAKE              // take exams (default for students)
  // Curriculum
  CURRICULUM_EDIT_OWN     // edit lectures/chapters in my offerings
  CURRICULUM_EDIT_ANY     // edit any course curriculum
  // Governance
  USERS_MANAGE            // create/disable user accounts
  ROLES_ASSIGN            // assign role + capabilities
  TEACHERS_VERIFY         // verify teacher profiles for onboarding
  // Quality
  QUALITY_VIEW            // read quality dashboards
  QUALITY_REPORT          // file quality reports
  // Communications
  ANNOUNCE_PLATFORM       // platform-wide announcements
  ANNOUNCE_FACULTY        // faculty/department/course announcements
  COMPETITIONS_RUN        // create competitions
  EVENTS_RUN              // create campus events
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT
  ESSAY
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum ExamKind {
  QUIZ
  MIDTERM
  FINAL
  PRACTICE
}

enum ExamStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  CLOSED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  EXPIRED
}

enum AnnouncementScope {
  PLATFORM
  FACULTY
  DEPARTMENT
  OFFERING
}

enum CompetitionStatus {
  OPEN
  CLOSED
  JUDGED
}

enum RsvpStatus {
  GOING
  MAYBE
  NO
}

// ────────────────────────────────────────────────────────────────
//  Identity & access
// ────────────────────────────────────────────────────────────────
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  role             Role
  firstName        String
  lastName         String
  avatarColor      String? // hex like "#4F8EF7"
  avatarInitials   String? // computed Arabic 2-letter initials
  emailVerifiedAt  DateTime?
  isActive         Boolean   @default(true)
  tokenVersion     Int       @default(0) // incremented to revoke all refresh tokens
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?

  enrollments       Enrollment[]       @relation("StudentEnrollments")
  taughtOfferings   CourseOffering[]   @relation("TeacherOfferings")
  submissions       Submission[]
  grades            Grade[]            @relation("StudentGrades")
  attendanceRecords AttendanceRecord[]
  uploadedMaterials Material[]         @relation("MaterialUploader")
  notifications     Notification[]
  sentMessages      Message[]          @relation("MessageSender")
  receivedMessages  Message[]          @relation("MessageReceiver")
  posts             Post[]
  postComments      PostComment[]
  postReactions     PostReaction[]
  studyRoomMembers  StudyRoomMember[]
  studyRoomsOwned   StudyRoom[]        @relation("StudyRoomOwner")
  loans             Loan[]
  moocEnrollments   MoocEnrollment[]
  jobApplications   JobApplication[]
  achievements      UserAchievement[]
  skills            UserSkill[]
  certificates      Certificate[]
  labSessions       LabSession[]
  aiConversations   AiConversation[]
  auditLogs         AuditLog[]
  watchEvents       WatchEvent[]       @relation("StudentWatchEvents")
  masteries         StudentMastery[]   @relation("StudentMasteries")
  researchPapers    ResearchPaper[]    @relation("StudentPapers")
  reviewedPapers    ResearchPaper[]    @relation("ProfessorReviewedPapers")
  paperAnnotations  PaperAnnotation[]
  trainingEnrollments TrainingEnrollment[]
  badges            UserBadge[]
  pointsLedger      PointsLedger[]
  // Governance
  permissionGrants  UserPermission[]   @relation("UserPermissionUser")
  permissionGrantedBy UserPermission[] @relation("UserPermissionGranter")
  verifiedTeachers  TeacherProfile[]   @relation("TeacherProfileVerifier")
  // Exams
  authoredQuestions Question[]         @relation("QuestionAuthor")
  moderatedQuestions Question[]        @relation("QuestionModerator")
  authoredExams     ExamTemplate[]     @relation("ExamAuthor")
  moderatedExams    ExamTemplate[]     @relation("ExamModerator")
  examAttempts      ExamAttempt[]
  // Social
  announcements     Announcement[]
  competitionsRun   Competition[]      @relation("CompetitionOrganizer")
  competitionEntries CompetitionEntry[]
  eventsRun         CampusEvent[]      @relation("EventOrganizer")
  eventRsvps        EventRSVP[]

  @@index([role])
  @@index([email])
}

model StudentProfile {
  userId       String     @id
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId String     @unique
  facultyId    String
  faculty      Faculty    @relation(fields: [facultyId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  year         Int        @default(1)
  gpa          Decimal    @default(0) @db.Decimal(3, 2)
  totalXp      Int        @default(0)
  level        Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([facultyId])
  @@index([departmentId])
}

model TeacherProfile {
  userId           String       @id
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty        String
  rank             AcademicRank @default(LECTURER)
  departmentId     String
  department       Department   @relation(fields: [departmentId], references: [id])
  bio              String?
  // Onboarding / suitability detection
  degreeLevel      DegreeLevel  @default(MASTERS)
  yearsExperience  Int          @default(0)
  certifications   Json?        // [{ title, issuer, year }]
  subjectKeywords  String[]     @default([]) // ["AI", "Machine Learning", "Statistics"]
  verifiedAt       DateTime?
  verifiedById     String?
  verifiedBy       User?        @relation("TeacherProfileVerifier", fields: [verifiedById], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([departmentId])
  @@index([verifiedById])
}

// ────────────────────────────────────────────────────────────────
//  Academic structure
// ────────────────────────────────────────────────────────────────
model Faculty {
  id          String           @id @default(cuid())
  name        String           @unique
  nameEn      String?
  iconEmoji   String?
  createdAt   DateTime         @default(now())
  departments Department[]
  students    StudentProfile[]
  questionCategories QuestionCategory[]
  examTemplates      ExamTemplate[]
}

model Department {
  id        String           @id @default(cuid())
  name      String
  nameEn    String?
  facultyId String
  faculty   Faculty          @relation(fields: [facultyId], references: [id])
  courses   Course[]
  students  StudentProfile[]
  teachers  TeacherProfile[]
  createdAt DateTime         @default(now())
  questionCategories QuestionCategory[]

  @@unique([facultyId, name])
  @@index([facultyId])
}

model Course {
  id           String             @id @default(cuid())
  code         String             @unique
  name         String
  nameEn       String?
  description  String?
  credits      Int                @default(3)
  iconEmoji    String?
  themeColor   String?
  departmentId String
  department   Department         @relation(fields: [departmentId], references: [id])
  offerings    CourseOffering[]
  concepts     KnowledgeConcept[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([departmentId])
}

model CourseOffering {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  teacherId String
  teacher   User     @relation("TeacherOfferings", fields: [teacherId], references: [id])
  term      String // e.g. "2024-FALL"
  room      String?
  capacity  Int      @default(40)
  createdAt DateTime @default(now())

  enrollments    Enrollment[]
  schedule       ScheduleSlot[]
  materials      Material[]
  assignments    Assignment[]
  attendance     AttendanceSession[]
  grades         Grade[]
  lectures       Lecture[]
  researchPapers ResearchPaper[]
  examTemplates  ExamTemplate[]

  @@unique([courseId, term, teacherId])
  @@index([teacherId])
  @@index([term])
}

model Enrollment {
  id          String         @id @default(cuid())
  studentId   String
  student     User           @relation("StudentEnrollments", fields: [studentId], references: [id])
  offeringId  String
  offering    CourseOffering @relation(fields: [offeringId], references: [id])
  status      String         @default("active")
  progressPct Int            @default(0)
  enrolledAt  DateTime       @default(now())

  @@unique([studentId, offeringId])
  @@index([offeringId])
}

model ScheduleSlot {
  id         String         @id @default(cuid())
  offeringId String
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0=Sunday … 6=Saturday (Arabic week starts Sunday)
  startTime  String // "08:00"
  endTime    String // "09:30"
  room       String?

  @@index([offeringId])
}

// ────────────────────────────────────────────────────────────────
//  Materials & uploads
// ────────────────────────────────────────────────────────────────
model Material {
  id          String         @id @default(cuid())
  offeringId  String
  offering    CourseOffering @relation(fields: [offeringId], references: [id])
  uploaderId  String
  uploader    User           @relation("MaterialUploader", fields: [uploaderId], references: [id])
  name        String
  description String?
  type        MaterialType
  sizeBytes   BigInt         @default(0)
  url         String
  views       Int            @default(0)
  downloads   Int            @default(0)
  createdAt   DateTime       @default(now())

  @@index([offeringId])
  @@index([type])
}

// ────────────────────────────────────────────────────────────────
//  Assignments & submissions
// ────────────────────────────────────────────────────────────────
model Assignment {
  id          String         @id @default(cuid())
  offeringId  String
  offering    CourseOffering @relation(fields: [offeringId], references: [id])
  title       String
  description String?
  type        AssignmentType
  dueAt       DateTime
  weight      Int            @default(10)
  maxScore    Int            @default(100)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  submissions Submission[]

  @@index([offeringId])
  @@index([dueAt])
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      User             @relation(fields: [studentId], references: [id])
  fileUrl      String?
  textAnswer   String?
  status       SubmissionStatus @default(SUBMITTED)
  grade        Decimal?         @db.Decimal(5, 2)
  feedback     String?
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

// ────────────────────────────────────────────────────────────────
//  Grades & attendance
// ────────────────────────────────────────────────────────────────
model Grade {
  id         String         @id @default(cuid())
  offeringId String
  offering   CourseOffering @relation(fields: [offeringId], references: [id])
  studentId  String
  student    User           @relation("StudentGrades", fields: [studentId], references: [id])
  kind       GradeKind
  score      Decimal        @db.Decimal(5, 2)
  maxScore   Int            @default(100)
  weight     Int            @default(10)
  feedback   String?
  recordedAt DateTime       @default(now())

  @@unique([offeringId, studentId, kind])
  @@index([studentId])
}

model AttendanceSession {
  id         String             @id @default(cuid())
  offeringId String
  offering   CourseOffering     @relation(fields: [offeringId], references: [id])
  date       DateTime
  topic      String?
  records    AttendanceRecord[]
  createdAt  DateTime           @default(now())

  @@unique([offeringId, date])
  @@index([offeringId])
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User              @relation(fields: [studentId], references: [id])
  status    AttendanceStatus
  notes     String?

  @@unique([sessionId, studentId])
  @@index([studentId])
}

// ────────────────────────────────────────────────────────────────
//  Notifications & messaging
// ────────────────────────────────────────────────────────────────
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  icon      String?
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model Message {
  id         String    @id @default(cuid())
  fromUserId String
  fromUser   User      @relation("MessageSender", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User      @relation("MessageReceiver", fields: [toUserId], references: [id])
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([toUserId, readAt])
  @@index([fromUserId])
}

// ────────────────────────────────────────────────────────────────
//  Social: posts, comments, study rooms
// ────────────────────────────────────────────────────────────────
model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  hashtags  String[]
  imageUrl  String?
  createdAt DateTime @default(now())

  comments  PostComment[]
  reactions PostReaction[]

  @@index([authorId])
  @@index([createdAt])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([postId])
}

model PostReaction {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id])
  kind   String // "like" | "save"

  @@unique([postId, userId, kind])
}

model StudyRoom {
  id        String            @id @default(cuid())
  name      String
  topic     String?
  ownerId   String
  owner     User              @relation("StudyRoomOwner", fields: [ownerId], references: [id])
  createdAt DateTime          @default(now())
  members   StudyRoomMember[]
}

model StudyRoomMember {
  roomId   String
  room     StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  joinedAt DateTime  @default(now())

  @@id([roomId, userId])
}

// ────────────────────────────────────────────────────────────────
//  Library
// ────────────────────────────────────────────────────────────────
model Book {
  id              String   @id @default(cuid())
  title           String
  author          String
  category        String // prog | net | db | ai | sec
  iconEmoji       String?
  themeColor      String?
  rating          Decimal? @db.Decimal(2, 1)
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  createdAt       DateTime @default(now())
  loans           Loan[]

  @@index([category])
}

model Loan {
  id         String     @id @default(cuid())
  bookId     String
  book       Book       @relation(fields: [bookId], references: [id])
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  borrowedAt DateTime   @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  status     LoanStatus @default(ACTIVE)

  @@index([userId])
  @@index([bookId])
}

// ────────────────────────────────────────────────────────────────
//  Gamification
// ────────────────────────────────────────────────────────────────
model Achievement {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  description String?
  icon        String?
  xp          Int               @default(50)
  users       UserAchievement[]
}

model UserAchievement {
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())

  @@id([userId, achievementId])
}

// ────────────────────────────────────────────────────────────────
//  Skills & certificates
// ────────────────────────────────────────────────────────────────
model Skill {
  id       String      @id @default(cuid())
  name     String      @unique
  category String?
  icon     String?
  users    UserSkill[]
}

model UserSkill {
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id])
  level       Int      @default(1) // 1..5
  progressPct Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([userId, skillId])
}

model Certificate {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  title       String
  issuer      String
  issuedAt    DateTime?
  hours       Int               @default(0)
  status      CertificateStatus @default(ONGOING)
  externalUrl String?
  fileUrl     String?
  trackId     String?
  track       TrainingTrack?    @relation(fields: [trackId], references: [id])
  createdAt   DateTime          @default(now())

  @@index([userId])
  @@index([trackId])
}

// ────────────────────────────────────────────────────────────────
//  External courses (MOOCs)
// ────────────────────────────────────────────────────────────────
model MoocCourse {
  id             String           @id @default(cuid())
  title          String
  organization   String
  iconEmoji      String?
  category       String
  durationHours  Int
  level          String
  rating         Decimal          @db.Decimal(2, 1)
  enrolled       Int              @default(0)
  hasCertificate Boolean          @default(true)
  jobReady       Boolean          @default(true)
  externalUrl    String?
  createdAt      DateTime         @default(now())
  enrollments    MoocEnrollment[]

  @@index([category])
}

model MoocEnrollment {
  id          String     @id @default(cuid())
  moocId      String
  mooc        MoocCourse @relation(fields: [moocId], references: [id])
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  progressPct Int        @default(0)
  status      String     @default("active")
  enrolledAt  DateTime   @default(now())

  @@unique([moocId, userId])
}

// ────────────────────────────────────────────────────────────────
//  Jobs
// ────────────────────────────────────────────────────────────────
model Job {
  id           String           @id @default(cuid())
  title        String
  company      String
  location     String
  type         JobType
  salary       String?
  description  String?
  iconEmoji    String?
  category     String // tech | intern | remote
  postedAt     DateTime         @default(now())
  expiresAt    DateTime?
  applications JobApplication[]

  @@index([category])
  @@index([type])
}

model JobApplication {
  id         String               @id @default(cuid())
  jobId      String
  job        Job                  @relation(fields: [jobId], references: [id])
  userId     String
  user       User                 @relation(fields: [userId], references: [id])
  status     JobApplicationStatus @default(APPLIED)
  matchScore Int?
  appliedAt  DateTime             @default(now())

  @@unique([jobId, userId])
  @@index([userId])
}

// ────────────────────────────────────────────────────────────────
//  Virtual labs & AR/VR
// ────────────────────────────────────────────────────────────────
model VirtualLab {
  id               String       @id @default(cuid())
  name             String
  platform         String? // "Cisco Packet Tracer", "Arduino Sim"…
  category         String
  iconEmoji        String?
  totalExperiments Int          @default(0)
  themeColor       String?
  sessions         LabSession[]
  createdAt        DateTime     @default(now())
}

model LabSession {
  id             String     @id @default(cuid())
  labId          String
  lab            VirtualLab @relation(fields: [labId], references: [id])
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  experimentName String
  progressPct    Int        @default(0)
  score          Decimal?   @db.Decimal(5, 2)
  startedAt      DateTime   @default(now())
  completedAt    DateTime?

  @@index([userId])
  @@index([labId])
}

model ArExperience {
  id          String           @id @default(cuid())
  title       String
  subject     String
  type        ArExperienceType
  description String?
  iconEmoji   String?
  themeColor  String?
  contentUrl  String?
  createdAt   DateTime         @default(now())
}

// ────────────────────────────────────────────────────────────────
//  AI conversations
// ────────────────────────────────────────────────────────────────
model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  title     String?
  createdAt DateTime    @default(now())
  messages  AiMessage[]

  @@index([userId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiMessageRole
  content        String
  tokens         Int            @default(0)
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

// ────────────────────────────────────────────────────────────────
//  Audit log
// ────────────────────────────────────────────────────────────────
model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String
  resourceType String?
  resourceId   String?
  ip           String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════════════════
//  Flipped Classroom — Lectures, Chapters, Checkpoints
//  Each lecture is a video + chaptered transcript + mid-video
//  checkpoints. Watch events feed the knowledge-tracing model.
// ════════════════════════════════════════════════════════════════

model Lecture {
  id            String         @id @default(cuid())
  offeringId    String
  offering      CourseOffering @relation(fields: [offeringId], references: [id])
  title         String
  description   String?
  ordinal       Int            @default(0)
  durationSec   Int            @default(0)
  videoUrl      String
  posterUrl     String?
  transcriptUrl String?
  createdAt     DateTime       @default(now())

  chapters    LectureChapter[]
  checkpoints LectureCheckpoint[]
  watchEvents WatchEvent[]

  @@index([offeringId])
  @@index([ordinal])
}

model LectureChapter {
  id        String            @id @default(cuid())
  lectureId String
  lecture   Lecture           @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  title     String
  startSec  Int
  endSec    Int
  ordinal   Int               @default(0)
  conceptId String?
  concept   KnowledgeConcept? @relation(fields: [conceptId], references: [id])

  @@index([lectureId])
}

model LectureCheckpoint {
  id           String            @id @default(cuid())
  lectureId    String
  lecture      Lecture           @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  conceptId    String?
  concept      KnowledgeConcept? @relation(fields: [conceptId], references: [id])
  triggerSec   Int
  question     String
  options      Json
  correctIndex Int
  explanation  String?

  @@index([lectureId])
}

model WatchEvent {
  id         String   @id @default(cuid())
  lectureId  String
  lecture    Lecture  @relation(fields: [lectureId], references: [id])
  studentId  String
  student    User     @relation("StudentWatchEvents", fields: [studentId], references: [id])
  watchedSec Int
  totalSec   Int
  completed  Boolean  @default(false)
  replays    Int      @default(0)
  lastSeenAt DateTime @default(now())

  @@unique([lectureId, studentId])
  @@index([studentId])
}

// ════════════════════════════════════════════════════════════════
//  Educational Matrix — concepts, mastery, gap-detection
// ════════════════════════════════════════════════════════════════

model KnowledgeConcept {
  id       String             @id @default(cuid())
  courseId String
  course   Course             @relation(fields: [courseId], references: [id])
  name     String
  parentId String?
  parent   KnowledgeConcept?  @relation("ConceptTree", fields: [parentId], references: [id])
  children KnowledgeConcept[] @relation("ConceptTree")
  ordinal  Int                @default(0)

  chapters    LectureChapter[]
  checkpoints LectureCheckpoint[]
  masteries   StudentMastery[]

  @@index([courseId])
}

model StudentMastery {
  id            String           @id @default(cuid())
  studentId     String
  student       User             @relation("StudentMasteries", fields: [studentId], references: [id])
  conceptId     String
  concept       KnowledgeConcept @relation(fields: [conceptId], references: [id])
  level         Decimal          @db.Decimal(4, 3) // 0.000 — 1.000
  attempts      Int              @default(0)
  correct       Int              @default(0)
  lastUpdatedAt DateTime         @default(now())

  @@unique([studentId, conceptId])
  @@index([studentId])
}

// ════════════════════════════════════════════════════════════════
//  Research Papers workflow
//  Upload → simulated plagiarism + AI-detection → professor grade
// ════════════════════════════════════════════════════════════════

enum ResearchPaperStatus {
  UPLOADED
  SCANNING
  CHECKS_PASSED
  CHECKS_FAILED
  GRADED
  PUBLISHED
}

model ResearchPaper {
  id            String              @id @default(cuid())
  studentId     String
  student       User                @relation("StudentPapers", fields: [studentId], references: [id])
  reviewerId    String?
  reviewer      User?               @relation("ProfessorReviewedPapers", fields: [reviewerId], references: [id])
  offeringId    String?
  offering      CourseOffering?     @relation(fields: [offeringId], references: [id])
  title         String
  abstract      String?
  fileUrl       String?
  status        ResearchPaperStatus @default(UPLOADED)
  plagiarismPct Decimal?            @db.Decimal(4, 1)
  aiContentPct  Decimal?            @db.Decimal(4, 1)
  grade         Decimal?            @db.Decimal(4, 1)
  feedback      String?
  uploadedAt    DateTime            @default(now())
  scannedAt     DateTime?
  gradedAt      DateTime?
  publishedAt   DateTime?
  extractedText String?             @db.Text
  annotations   PaperAnnotation[]

  @@index([studentId])
  @@index([reviewerId])
  @@index([status])
}

// Inline feedback on a research paper. Teachers/reviewers leave page-anchored
// comments; the student sees them when reading the graded paper.
model PaperAnnotation {
  id        String        @id @default(cuid())
  paperId   String
  paper     ResearchPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  page      Int           // 1-indexed PDF page
  comment   String        @db.Text
  color     String?       // hex like "#F5A623" — UI tint; null → default
  createdAt DateTime      @default(now())

  @@index([paperId])
  @@index([authorId])
}


// ────────────────────────────────────────────────────────────────
//  Training tracks & rewards (Self-Development module)
// ────────────────────────────────────────────────────────────────
//  TrainingTrack       a self-contained learning path (e.g. "Research Skills")
//  TrainingLesson      ordered lessons inside a track, optional check-question
//  TrainingEnrollment  student joins a track
//  LessonProgress      one row per completed lesson per enrollment
//  Badge / UserBadge   visual milestones (per-track + cross-cutting)
//  PointsLedger        append-only audit of every point award
// ────────────────────────────────────────────────────────────────

enum TrainingTrackCategory {
  ONBOARDING
  ACADEMIC
  FLIPPED
  STUDY_SKILLS
  RESEARCH
  CAREER
  COMMUNICATION
  ENGLISH
  PROGRAMMING
  PRODUCTIVITY
  VISION
}

model TrainingTrack {
  id           String                @id @default(cuid())
  slug         String                @unique
  title        String
  titleEn      String?
  summary      String                @db.Text
  category     TrainingTrackCategory
  level        String                @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  iconEmoji    String?
  themeColor   String?
  estMinutes   Int                   @default(60)
  pointsAward  Int                   @default(200)
  order        Int                   @default(0)
  isPublished  Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  lessons      TrainingLesson[]
  enrollments  TrainingEnrollment[]
  badges       Badge[]
  certificates Certificate[]

  @@index([category])
  @@index([order])
}

model TrainingLesson {
  id              String           @id @default(cuid())
  trackId         String
  track           TrainingTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  order           Int
  title           String
  summary         String?
  contentMarkdown String           @db.Text
  estMinutes      Int              @default(8)
  pointsAward     Int              @default(5)
  quizQuestion    String?
  quizAnswer      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  progresses      LessonProgress[]

  @@unique([trackId, order])
  @@index([trackId])
}

model TrainingEnrollment {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  trackId     String
  track       TrainingTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  startedAt   DateTime         @default(now())
  completedAt DateTime?

  progresses  LessonProgress[]

  @@unique([userId, trackId])
  @@index([userId])
  @@index([trackId])
}

model LessonProgress {
  id            String              @id @default(cuid())
  enrollmentId  String
  enrollment    TrainingEnrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId      String
  lesson        TrainingLesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt   DateTime            @default(now())
  pointsAwarded Int                 @default(0)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
}

model Badge {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String
  iconEmoji   String
  themeColor  String?
  rarity      String         @default("COMMON") // COMMON | RARE | EPIC | LEGENDARY
  trackId     String?
  track       TrainingTrack? @relation(fields: [trackId], references: [id])
  createdAt   DateTime       @default(now())

  users       UserBadge[]

  @@index([trackId])
}

model UserBadge {
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now())

  @@id([userId, badgeId])
  @@index([userId])
}

model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int
  reason    String
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}


// ════════════════════════════════════════════════════════════════
//  Governance: capabilities + role/user permissions
// ════════════════════════════════════════════════════════════════
//  Two-layer model:
//    1. RolePermission — defaults granted by Role
//    2. UserPermission — explicit overrides per user (grant or revoke)
//
//  Effective caps = (RolePermission for user.role) ∪ (UserPermission grants)
//                   ∖ (UserPermission revokes)
// ────────────────────────────────────────────────────────────────

model RolePermission {
  role       Role
  capability Capability

  @@id([role, capability])
  @@index([role])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation("UserPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  capability   Capability
  // grant=true means this cap is explicitly given even if role doesn't have it.
  // grant=false means this cap is explicitly revoked even if role has it.
  grant        Boolean    @default(true)
  grantedAt    DateTime   @default(now())
  grantedById  String?
  grantedBy    User?      @relation("UserPermissionGranter", fields: [grantedById], references: [id])
  reason       String?

  @@unique([userId, capability])
  @@index([userId])
}

// ════════════════════════════════════════════════════════════════
//  Unified exams + question bank
// ════════════════════════════════════════════════════════════════

model QuestionCategory {
  id            String      @id @default(cuid())
  slug          String      @unique
  title         String
  description   String?
  facultyId     String?
  faculty       Faculty?    @relation(fields: [facultyId], references: [id])
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  isShared      Boolean     @default(false) // visible across faculties
  iconEmoji     String?
  createdAt     DateTime    @default(now())

  questions     Question[]

  @@index([facultyId])
  @@index([departmentId])
}

model Question {
  id              String          @id @default(cuid())
  categoryId      String
  category        QuestionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  type            QuestionType
  prompt          String          @db.Text
  // For MCQ/TF: array of choice strings. For SHORT/ESSAY: null.
  choices         Json?
  // For MCQ: index into choices. For TF: 0=true, 1=false. For SHORT: model answer string. For ESSAY: rubric.
  correctAnswer   Json?
  difficulty      DifficultyLevel @default(MEDIUM)
  points          Int             @default(1)
  tags            String[]        @default([])
  authorId        String
  author          User            @relation("QuestionAuthor", fields: [authorId], references: [id])
  isApproved      Boolean         @default(false)
  moderatedById   String?
  moderatedBy     User?           @relation("QuestionModerator", fields: [moderatedById], references: [id])
  moderationNote  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  templateLinks   ExamTemplateQuestion[]
  examAnswers    ExamAnswer[]

  @@index([categoryId])
  @@index([authorId])
  @@index([difficulty])
  @@index([isApproved])
}

model ExamTemplate {
  id              String         @id @default(cuid())
  offeringId      String?
  offering        CourseOffering? @relation(fields: [offeringId], references: [id])
  facultyId       String?        // faculty-wide unified exam
  faculty         Faculty?       @relation(fields: [facultyId], references: [id])
  title           String
  kind            ExamKind       @default(QUIZ)
  description     String?        @db.Text
  durationMin     Int            @default(45)
  passingScore    Int            @default(50)
  randomized      Boolean        @default(true)
  status          ExamStatus     @default(DRAFT)
  authorId        String
  author          User           @relation("ExamAuthor", fields: [authorId], references: [id])
  moderatedById   String?
  moderatedBy     User?          @relation("ExamModerator", fields: [moderatedById], references: [id])
  moderationNote  String?
  openAt          DateTime?
  closeAt         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  questions       ExamTemplateQuestion[]
  attempts        ExamAttempt[]

  @@index([offeringId])
  @@index([facultyId])
  @@index([authorId])
  @@index([status])
}

model ExamTemplateQuestion {
  id           String       @id @default(cuid())
  templateId   String
  template     ExamTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question     @relation(fields: [questionId], references: [id])
  order        Int
  pointsOverride Int?       // override the question's default points

  @@unique([templateId, questionId])
  @@unique([templateId, order])
  @@index([templateId])
}

model ExamAttempt {
  id           String        @id @default(cuid())
  templateId   String
  template     ExamTemplate  @relation(fields: [templateId], references: [id])
  studentId    String
  student      User          @relation(fields: [studentId], references: [id])
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  expiresAt    DateTime
  status       AttemptStatus @default(IN_PROGRESS)
  score        Decimal?      @db.Decimal(6, 2)
  maxScore     Decimal       @db.Decimal(6, 2)

  answers      ExamAnswer[]

  @@index([templateId])
  @@index([studentId])
  @@index([status])
}

model ExamAnswer {
  id            String      @id @default(cuid())
  attemptId     String
  attempt       ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id])
  // Student input — interpreted per question type
  answerText    String?     @db.Text
  choiceIndex   Int?
  isCorrect     Boolean?    // null = pending manual review
  awardedPoints Decimal?    @db.Decimal(6, 2)
  feedback      String?
  answeredAt    DateTime    @default(now())

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ════════════════════════════════════════════════════════════════
//  Social / community
// ════════════════════════════════════════════════════════════════

model Announcement {
  id          String            @id @default(cuid())
  authorId    String
  author      User              @relation(fields: [authorId], references: [id])
  scope       AnnouncementScope
  scopeId     String?           // facultyId / departmentId / offeringId
  title       String
  body        String            @db.Text
  pinned      Boolean           @default(false)
  publishedAt DateTime          @default(now())
  expiresAt   DateTime?
  iconEmoji   String?

  @@index([scope, scopeId])
  @@index([publishedAt])
}

model Competition {
  id           String              @id @default(cuid())
  title        String
  description  String              @db.Text
  category     String              // "بحث" | "برمجة" | "ابتكار" | "محاضرة" | "تصميم" ...
  prize        String?
  deadline     DateTime
  organizerId  String
  organizer    User                @relation("CompetitionOrganizer", fields: [organizerId], references: [id])
  status       CompetitionStatus   @default(OPEN)
  iconEmoji    String?
  themeColor   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  entries      CompetitionEntry[]

  @@index([status])
  @@index([deadline])
}

model CompetitionEntry {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  title         String
  body          String      @db.Text
  fileUrl       String?
  submittedAt   DateTime    @default(now())
  score         Int?        // judging score, null until judged

  @@unique([competitionId, userId])
  @@index([competitionId])
}

model CampusEvent {
  id           String       @id @default(cuid())
  title        String
  description  String       @db.Text
  location     String
  startsAt     DateTime
  endsAt       DateTime
  capacity     Int          @default(100)
  organizerId  String
  organizer    User         @relation("EventOrganizer", fields: [organizerId], references: [id])
  iconEmoji    String?
  themeColor   String?
  createdAt    DateTime     @default(now())

  rsvps        EventRSVP[]

  @@index([startsAt])
}

model EventRSVP {
  eventId   String
  event     CampusEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  status    RsvpStatus  @default(GOING)
  rsvpedAt  DateTime    @default(now())

  @@id([eventId, userId])
  @@index([userId])
}


// ════════════════════════════════════════════════════════════════
//  University data synchronization (PRD: daily sync from zu.edu.ly)
// ════════════════════════════════════════════════════════════════
//  UniversityFact   key/value store of public institutional facts
//                   (vision, mission, contact, grade scale, etc.)
//  SyncRun          audit log of every sync attempt
// ────────────────────────────────────────────────────────────────

enum SyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model UniversityFact {
  /// Stable key — e.g. "name", "foundingYear", "phone.primary",
  /// "address", "vision", "mission", "grade.scale.excellent".
  key       String   @id
  /// Localized display value (Arabic by default; English-tagged keys for English).
  value     String   @db.Text
  /// Group: general | identity | contact | strategic | grading | colleges | calendar | other
  category  String   @default("general")
  /// Where the value came from: "zu.edu.ly:about" | "zu.edu.ly:faculty" | "manual"
  source    String   @default("zu.edu.ly")
  syncedAt  DateTime @default(now())
  /// Marked stale if a sync run could not refresh it.
  isStale   Boolean  @default(false)

  @@index([category])
}

model SyncRun {
  id           String        @id @default(cuid())
  startedAt    DateTime      @default(now())
  completedAt  DateTime?
  status       SyncRunStatus @default(RUNNING)
  source       String        @default("static-markdown")
  factsAdded   Int           @default(0)
  factsUpdated Int           @default(0)
  errorMsg     String?       @db.Text
  durationMs   Int?
  /// Free-form notes / fields the run could not resolve.
  notes        String?       @db.Text

  @@index([startedAt])
  @@index([status])
}
