  @@index([userId])
  @@index([feature])
  @@index([createdAt])
  @@index([success])
}

// r323 B1.2 — the RAG store. One row = one retrievable chunk of course
// truth (a lecture-transcript window, a checkpoint's question+answer,
// a course description, a material abstract). Lexical retrieval rides
// pg_trgm (the migration adds the GIN index); embeddings stay OFF
// until a pgvector-capable database actually exists (honest scope).
// The citation fields are denormalized ON PURPOSE: the chat route
// renders «المصدر: …» straight from the hit row, one read, no joins.
model AiKnowledgeChunk {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  // Where the chunk came from — 'lecture' (transcript window),
  // 'checkpoint', 'course', 'material'.
  sourceType    String
  sourceId      String
  // Citation display: title + human locator («الدقيقة 14:20», «ص 5»)
  // + the deep link that opens the player at the timestamp / PDF page.
  title         String
  locator       String?
  url           String?
  // The chunk body, as written (Arabic normalization happens at QUERY
  // time so the stored text stays human-readable/printable).
  content       String
  createdAt     DateTime    @default(now())

  @@index([institutionId])
  @@index([sourceType, sourceId])
}

model OperationalAlert {
  id         String    @id @default(cuid())
  severity   String
  category   String
  title      String
  message    String    @db.Text
  metadata   Json?
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())

  @@index([severity])
  @@index([category])
  @@index([resolvedAt])
  @@index([createdAt])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([success])
  @@index([createdAt])
  @@index([email])
}

// ────────────────────────────────────────────────────────────────
//  R320 §D — forgot-password reset tokens (PAGES-GAP.md §5)
// ────────────────────────────────────────────────────────────────
// One single-use token per request: 32 random bytes handed to the user
// as base64url (43 chars), stored ONLY as its sha-256 hex digest — a
// FAST hash on purpose (unlike argon2 for passwords): the token is
// 128-bit random + 30-min TTL, so pre-image cost is irrelevant while
// lookup cost must stay cheap per reset attempt.
//
// · expiresAt = mint + 30 min; usedAt != null marks the token spent
//   (claimed atomically via updateMany CAS on usedAt = null — no
//   read-then-write double-spend window).
// · ONE live token per user is enforced at MINT time (the service marks
//   any prior outstanding token used before creating the new one); the
//   unique tokenHash additionally makes digest collisions impossible.
// · userId cascades: deleting a user deletes their tokens.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha-256 hex of the base64url token — NEVER the raw token
  expiresAt DateTime // mint + 30 min (the spec's TTL)
  usedAt    DateTime? // null = outstanding; set = claimed (single use)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ────────────────────────────────────────────────────────────────
//  Durable binary storage (r175 — pilot persistence on Render Free)
// ────────────────────────────────────────────────────────────────

// Uploaded PDFs stored as BYTEA rows when STORAGE_DRIVER=postgres
// (backend/src/lib/storage.ts PostgresDriver). The `key` is the SAME
// canonical storage key the local/S3 drivers use
// (`<papers|materials>/<cuid>.pdf`) — namespace semantics, access
// gates and serving routes are unchanged; only the byte sink differs.
// Rows are bounded by the 20 MB upload cap and the per-user quota.
// Honest scope: a bounded pilot trade-off (bytes live in the app's
// own Neon database) — see docs/16-decisions-and-limitations.md.
model BinaryObject {
  key       String   @id
  bytes     Bytes
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────
//  AI cost control + answer feedback (r323 B1.1)
// ────────────────────────────────────────────────────────────────
// Additive to the AiTelemetry family: quota and budget counters keep
// the SAME honesty ruling (tokens come from the provider's usage block
// only — local mode writes 0, never an estimate). Rows are keyed by
// the bare userId string (the AiTelemetry precedent — no FK), so these
// tables never touch the User model and the migration stays purely
// additive.

// One row per USER: the CURRENT UTC day's ask counter. `dayKey`
// ('YYYY-MM-DD') tells which day `used` belongs to; the route resets
// stale rows via an updateMany CAS where dayKey ≠ today (the day
// roll-over never read-modify-writes across statements).
model AiQuota {
  id     String @id @default(cuid())
  userId String @unique
  dayKey String
  used   Int    @default(0)

  @@index([dayKey])
}

// One row per MONTH: the platform-wide token budget counter.
// `monthKey` ('YYYY-MM') is unique — the month roll-over starts a fresh
// row. usedTokens accumulates REAL provider usage (input + output from
// the usage block); estimatedCostMicros stays 0 until a real price
// table exists (an honest zero, never a fabricated estimate).
model AiBudget {
  id                  String @id @default(cuid())
  monthKey            String @unique
  usedTokens          Int    @default(0)
  estimatedCostMicros Int    @default(0)
}

// One rating per user per assistant answer (upsert — the last rating
// wins). rating: 1 (helpful) / -1 (not helpful), SMALLINT on the wire.
// The (messageId, userId) unique pair is both the idempotency key and
// the ownership guarantee's complement: the route verifies the message
// belongs to the caller's conversation before the upsert.
model AiFeedback {
  id        String   @id @default(cuid())
  userId    String
  messageId String
  rating    Int      @db.SmallInt
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

// ────────────────────────────────────────────────────────────────
// r323 B3.1 — invite codes (single-use/expiring, scoped self-registration)
// ────────────────────────────────────────────────────────────────
model InviteCode {
  id           String          @id @default(cuid())
  code         String          @unique
  role         Role
  // The scope the code enrolls into: exactly one of offering/department/
  // faculty (a code may target a course section, a department, or a whole
  // faculty — the register flow shows the target honestly before submit).
  offeringId   String?
  offering     CourseOffering? @relation(fields: [offeringId], references: [id])
  departmentId String?
  department   Department?     @relation(fields: [departmentId], references: [id])
  facultyId    String?
  faculty      Faculty?        @relation(fields: [facultyId], references: [id])
  createdById  String
  createdBy    User            @relation("InviteCodeCreator", fields: [createdById], references: [id])
  expiresAt    DateTime
  maxUses      Int             @default(1)
  usedCount    Int             @default(0)
  uses         InviteUse[]
  createdAt    DateTime        @default(now())

  @@index([createdById])
}

model InviteUse {
  id     String     @id @default(cuid())
  codeId String
  code   InviteCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId String
  user   User       @relation("InviteUseUser", fields: [userId], references: [id])
  usedAt DateTime   @default(now())

  @@unique([codeId, userId])
}

// ────────────────────────────────────────────────────────────────
// r323 B3.6 — the pilot feedback loop: the floating «أبلغ عن مشكلة /
// اقتراح» lands here — route, role, browser, the last ~20 console
// errors, an optional (downscaled) screenshot — and the registrar/
// owner inbox works the status. Weekly digest reads the same rows.
// ────────────────────────────────────────────────────────────────
model PilotFeedback {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  kind       String // BUG | IDEA
  role       String? // the sender's role at send time
  route      String? // the SPA path it was filed from
  userAgent  String?
  console    Json? // [{ t, text }] — the consoleTape ring (≤ 20 rows)
  note       String   @db.Text
  // The optional screenshot: a client-downscaled JPEG data URL
  // (≤ 1280px wide, ≤ 600 KB) — a pilot-scale convenience, not a
  // storage product; the inbox renders it inline.
  screenshot String?
  status     String   @default("open") // open → triage → fixed | dismissed
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

// r326 M1.1 — native client crash/error telemetry (additive). Written by
// the mobile app's telemetry layer (fire-and-forget POST /client-errors,
// unauthenticated so login-time crashes still report; strict rate limit +
// zod validation at the route). The OWNER inbox reads it.
model ClientError {
  id             String    @id @default(cuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])
  kind           String // crash | js_error | unhandled_rejection | api_error | render
  message        String    @db.Text
  stack          String?   @db.Text
  route          String?
  role           String?
  breadcrumbs    Json? // [{ t, text }] ring (≤ 30 rows)
  appVersion     String?
  updateId       String? // expo-updates id — which OTA the user runs
  runtimeVersion String?
  deviceModel    String?
  osName         String?
  osVersion      String?
  userAgent      String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([kind, createdAt])
  @@index([reviewedAt, createdAt])
  @@index([userId])
}

// r326 M2.6 — Expo push device registration (additive; per the mobile
// proposal apps/mobile/docs/push-backend-proposal.md). Upserted by token;
// pruned when Expo reports DeviceNotRegistered or after 180 idle days.
model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String // ANDROID | IOS | WEB
  expoToken  String   @unique
  appVersion String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([lastSeenAt])
}

// ── R350 E2 — the transactional-mail outbox + suppression list ──────
// The provider layer (lib/mail.ts) is fire-and-forget: a transport
// failure lost the message. The outbox makes every logical send a DB
// row first (rendered ONCE — byte-stable across retries), drained by
// the in-process worker with exponential backoff and a dead-letter
// state. Suppression (E4) is consulted before every send: a
// hard-bounced / complained / unsubscribed address never receives
// another message.

enum MailOutboxStatus {
  queued
  sending
  sent
  failed
  suppressed
}

model MailOutbox {
  id           String           @id @default(cuid())
  to           String
  template     String
  subject      String
  html         String           @db.Text
  text         String           @db.Text
  status       MailOutboxStatus @default(queued)
  attempts     Int              @default(0)
  nextAttemptAt DateTime        @default(now())
  provider     String?
  providerId   String?
  lastError    String?          @db.Text
  /// Idempotency key per logical send (e.g. `reset:<userId>:<tokenHash>`)
  /// — a replayed request must never double-send.
  dedupeKey    String?          @unique
  /// Institution context for the per-institution daily cap (nullable:
  /// platform-level mail has no institution).
  institutionId String?
  sentAt       DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, nextAttemptAt])
  @@index([to, createdAt])
  @@index([institutionId, createdAt])
}

model MailSuppression {
  id           String   @id @default(cuid())
  email        String
  /// hard_bounce | complaint | unsubscribe | manual
  type         String
  reason       String   @db.Text
  suppressedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([email, type])
  @@index([email])
}
