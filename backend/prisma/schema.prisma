// ════════════════════════════════════════════════════════════════
//  Madarek AI — Prisma schema (PostgreSQL)
// ════════════════════════════════════════════════════════════════
//  Models the full domain extracted from the prototype:
//  users + role profiles, faculties, departments, courses,
//  offerings, enrollments, schedule, attendance, grades,
//  assignments, materials, messages, notifications, posts,
//  library/loans, MOOCs, jobs, achievements, skills,
//  virtual labs, AR experiences, AI conversations, audit log.
// ────────────────────────────────────────────────────────────────
//  r178 — MULTI-INSTITUTION FOUNDATION:
//  · NEW Institution + Membership models: one product/brand (مدارك)
//    serving multiple institutions as CONTEXT labels (no per-university
//    logos/themes/domains). Membership is the per-user, per-institution
//    standing — the effective institutional role ALWAYS comes from
//    Membership.role; User.role stays the platform-level role
//    (OWNER = platform owner; STUDENT/TEACHER/ADMIN/QUALITY = legacy
//    demo default).
//  · Scoped uniqueness: Faculty (institutionId, name, city); student
//    reg-number universityId (institutionId, universityId); course code
//    (institutionId, code). Email stays globally unique.
//  · StudentProfile/TeacherProfile become per-MEMBERSHIP rows with their
//    own cuid PKs (userId keeps FK + index for legacy reads).
//  · UserPermission/AuditLog gain nullable institutionId (NULL =
//    platform scope).
//  · Deliberately untouched (Phase 5): Announcement/PlatformSetting/
//    FeatureFlag (platform-global), offerings/enrollments/grades
//    (ownership via the verified parent chain).
// ────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Note: providers like Neon support pooled & direct connection strings.
  // For this project we use a single Neon "pooler" URL that works for both
  // runtime queries and `prisma migrate`. If you ever need to split them,
  // re-enable directUrl below and set DIRECT_DATABASE_URL to the unpooled host.
  // directUrl = env("DIRECT_DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────
//  Enums
// ────────────────────────────────────────────────────────────────
enum Role {
  STUDENT
  TEACHER
  ADMIN
  QUALITY
  OWNER
}

// r178 — مؤسسات متعددة: حالة المؤسسة (تعليق المؤسسة يمنع كل وصول
// متعلق بها عبر حرّاس السياق في الخلفية).
enum InstitutionStatus {
  ACTIVE
  SUSPENDED
}

// master-E1 — نوع المؤسسة التعليمية: المدرسة مواطن من الدرجة الأولى
// بقدر الجامعة (مدارك تخدم الاثنين + مراكز التدريب). القيمة nullable
// عمدًا للتوافق الرجعي: الصفوف القائمة (عرض r178 والمؤسسات التجريبية)
// تُقرأ بدون قيمة = نمط جامعي — نفس الدلالة التاريخية — ولا تُحدَّث
// إلا صراحةً عندما يختار المالك نوع مؤسسته.
enum InstitutionKind {
  SCHOOL // مدرسة (ابتدائية/إعدادية/ثانوية) — نمط المرحلة/الصف/الفصل
  UNIVERSITY // جامعة — نمط الكلية/القسم/السنة (الحقول التاريخية)
  COLLEGE // كلية/معهد عالٍ
  TRAINING_CENTER // مركز تدريب/تعليم مستمر
  OTHER // غير ذلك
}

// master-E1 — جنس صاحب الملف (اختياري في ملف الطالب). UNSPECIFIED هي
// قيمة عدم الإفصاح — لم تُهيّأ قيمة افتراضية للعمود حتى لا تُخزَّن
// دلالة لم يصرّح بها المستخدم.
enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

