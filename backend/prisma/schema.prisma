// ────────────────────────────────────────────────────────────────
//  r178 — Institutions & memberships (أساس المؤسسات المتعددة)
// ────────────────────────────────────────────────────────────────

// المؤسسة سياق تعليمي داخل مدارك (ليست هوية بصرية — لا شعارات ولا
// نطاقات). المؤسسة التجريبية المرجعية «مؤسسة مدارك النموذجية» (id:
// inst-madarek-demo، slug: madarek-demo) تحمل البيانات التجريبية؛
// ومؤسسة الأندلس التعليمية (slug: alandalus-demo) مؤسسة تجريبية عامة
// تثبت تفرد رموز المقررات وأرقام التسجيل على مستوى المؤسسة لا المنصة.
model Institution {
  id             String            @id @default(cuid())
  name           String
  nameEn         String?
  slug           String            @unique
  status         InstitutionStatus @default(ACTIVE)
  // master-E1 — النوع التعليمي (مدرسة/جامعة/كلية/مركز تدريب). NULL =
  // النمط الجامعي التاريخي (توافق رجعي: كل الصفوف القائمة أُنشئت في
  // سياق جامعي). يحدد النمط أي حقول الملف الطالب تُعرض/تُلزم:
  // SCHOOL → stage/grade/section… ، UNIVERSITY → faculty/department/year…
  kind           InstitutionKind?
  // master-E1 — إعدادات أكاديمية مضبوطة (ليست حقيبة JSON حرة).
  // الشكل المُتحكَّم به (يُصدَّق في طبقة الخدمة، لا في القاعدة):
  //   {
  //     gradingScale?: {
  //       kind: 'PERCENT_100' | 'GPA_4' | 'GPA_5',   // سلم التنقيط
  //       passMark?: number,                          // حد النجاح (نسبة أو معدل)
  //       decimals?: number                           // خانات التقريب (0-3)
  //     },
  //     stages?: Array<{                             // مراحل المؤسسة (kind=SCHOOL)
  //       key: string,                               // مفتاح ثابت (slug)
  //       labelAr: string,                           // «المرحلة الثانوية»
  //       labelEn?: string,
  //       grades?: Array<{ key: string; labelAr: string; labelEn?: string }>
  //     }>,
  //     sections?: string[]                          // أسماء الفصول المتاحة («أ»، «ب»…)
  //   }
  // أي مفتاح غير معرَّف = تكوين غير مقبول (تُرفض الكتابة لا تُهمَل).
  academicConfig Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  memberships       Membership[]
  faculties         Faculty[]
  students          StudentProfile[]
  courses           Course[]
  permissionGrants  UserPermission[]
  auditLogs         AuditLog[]
  posts             Post[]
  studyRooms        StudyRoom[]
  campusEvents      CampusEvent[]
  competitions      Competition[]
  researchPapers    ResearchPaper[]
  aiConversations   AiConversation[]
  aiKnowledgeChunks AiKnowledgeChunk[]
  // master-E1 — تعريفات الحقول المخصصة لهذه المؤسسة (النظام البنيوي
  // للحقول المخصصة — انظر InstitutionFieldDefinition أدناه).
  fieldDefinitions  InstitutionFieldDefinition[]
  // master-F1 — وظائف الاستيراد ومخططات الأعمدة المحفوظة.
  importJobs        ImportJob[]
  importMappings    ImportMappingProfile[]

  @@index([status])
}

// عضوية المستخدم داخل مؤسسة واحدة — مصدر الدور الفعلي داخل المؤسسة.
// التفرد (userId, institutionId) يضمن صفًّا واحدًا لكل زوج، وisActive=false
// هو مقبض سحب الصلاحية (يُلغى/يُستعاد دون حذف التاريخ).
//
// ⚠ role يعيد استخدام enum المسمى Role — قيمة OWNER محظورة هنا على
// مستوى التطبيق (Zod DTOs + حرّاس الخدمة): Prisma 5.22 لا يدعم قيود
// CHECK. ملكية المنصة تُعبَّر عنها فقط بـ User.role == OWNER ولا يكون
// للمالك عضوية مؤسسة إطلاقًا.
model Membership {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  role          Role
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  studentProfiles StudentProfile[]
  teacherProfiles TeacherProfile[]

  @@unique([userId, institutionId])
  @@index([institutionId, role])
  @@index([institutionId, isActive])
  @@index([userId, isActive])
}

// ────────────────────────────────────────────────────────────────
//  Identity & access
// ────────────────────────────────────────────────────────────────
model User {
  id                       String          @id @default(cuid())
  email                    String          @unique
  passwordHash             String
  role                     Role
  firstName                String
  lastName                 String
  avatarColor              String? // hex like "#4F8EF7"
  avatarInitials           String? // computed Arabic 2-letter initials
  emailVerifiedAt          DateTime?
  isActive                 Boolean         @default(true)
  tokenVersion             Int             @default(0) // incremented to revoke all refresh tokens
  failedLoginCount         Int             @default(0)
  lockedUntil              DateTime?
  // Governance scope — for ADMIN/QUALITY users.
  // NULL = university-wide; set = scoped to that faculty only.
  scopeFacultyId           String?
  scopeFaculty             Faculty?        @relation("FacultyScopedAdmins", fields: [scopeFacultyId], references: [id])
  // 012-design-graphics-uplift — presentation preferences (no PII).
  // See specs/012-design-graphics-uplift/data-model.md.
  themePreference          ThemePreference @default(SYSTEM)
  themePreferenceUpdatedAt DateTime        @default(now())
  onboardingCompletedAt    DateTime?
  firedMilestones          String[]        @default([])
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  // r178: profiles are per-MEMBERSHIP now (a user can study in one
  // institution and teach in another) — hence plural reverse relations.
  // Legacy single-profile surfaces resolve via the membership context.
  memberships     Membership[]
  studentProfiles StudentProfile[]
  teacherProfiles TeacherProfile[]

  enrollments         Enrollment[]         @relation("StudentEnrollments")
  taughtOfferings     CourseOffering[]     @relation("TeacherOfferings")
  submissions         Submission[]
  grades              Grade[]              @relation("StudentGrades")
  attendanceRecords   AttendanceRecord[]
  uploadedMaterials   Material[]           @relation("MaterialUploader")
  notifications       Notification[]
  sentMessages        Message[]            @relation("MessageSender")
  receivedMessages    Message[]            @relation("MessageReceiver")
  posts               Post[]
  postComments        PostComment[]
  postReactions       PostReaction[]
  studyRoomMembers    StudyRoomMember[]
  studyRoomsOwned     StudyRoom[]          @relation("StudyRoomOwner")
  loans               Loan[]
  moocEnrollments     MoocEnrollment[]
  jobApplications     JobApplication[]
  achievements        UserAchievement[]
  skills              UserSkill[]
  certificates        Certificate[]
  labSessions         LabSession[]
  aiConversations     AiConversation[]
  auditLogs           AuditLog[]
  watchEvents         WatchEvent[]         @relation("StudentWatchEvents")
  checkpointAnswers   CheckpointAnswer[]   @relation("StudentCheckpointAnswers")
  masteries           StudentMastery[]     @relation("StudentMasteries")
  researchPapers      ResearchPaper[]      @relation("StudentPapers")
  reviewedPapers      ResearchPaper[]      @relation("ProfessorReviewedPapers")
  paperAnnotations    PaperAnnotation[]
  trainingEnrollments TrainingEnrollment[]
  badges              UserBadge[]
  pointsLedger        PointsLedger[]
  // Governance
  permissionGrants    UserPermission[]     @relation("UserPermissionUser")
  permissionGrantedBy UserPermission[]     @relation("UserPermissionGranter")
  verifiedTeachers    TeacherProfile[]     @relation("TeacherProfileVerifier")
  // Exams
  authoredQuestions   Question[]           @relation("QuestionAuthor")
  moderatedQuestions  Question[]           @relation("QuestionModerator")
  authoredExams       ExamTemplate[]       @relation("ExamAuthor")
  moderatedExams      ExamTemplate[]       @relation("ExamModerator")
  examAttempts        ExamAttempt[]
  liveSessions        LiveSession[]        @relation("LiveSessionTeacher")
  // Social
  announcements       Announcement[]
  competitionsRun     Competition[]        @relation("CompetitionOrganizer")
  competitionEntries  CompetitionEntry[]
  eventsRun           CampusEvent[]        @relation("EventOrganizer")
  eventRsvps          EventRSVP[]
  // R320 §D (P0-3/P0-4) — the forgot-password flow's single-use tokens.
  passwordResetTokens PasswordResetToken[]

  // r323 B3.1 — the invite codes this user issued / consumed.
  issuedInvites InviteCode[] @relation("InviteCodeCreator")
  inviteUses    InviteUse[]  @relation("InviteUseUser")

  // r323 B3.6 — the pilot feedback loop the user filed.
  feedbackSent PilotFeedback[]

  // r326 M1.1 — the client-error telemetry the user's devices sent
  // (optional userId — anonymous crash reports are accepted).
  clientErrors ClientError[]

  // r326 M2.6 — the push devices registered by this user's installs.
  pushDevices PushDevice[]

  // master-F1 — وظائف الاستيراد التي أنشأها هذا المستخدم + مخططات
  // الأعمدة التي حفظها (العلاقة المسماة لأن User مكتظ بالعلاقات).
  importJobsCreated          ImportJob[]            @relation("ImportJobCreator")
  importMappingProfilesSaved ImportMappingProfile[] @relation("ImportMappingProfileCreator")

  @@index([role])
  @@index([email])
  @@index([scopeFacultyId])
}

model StudentProfile {
  // r178 restructure: the profile is per-MEMBERSHIP, not per-user — the
  // same user may hold student profiles in different institutions. New
  // cuid PK; the legacy userId PK is gone (userId keeps FK + index for
  // legacy single-context reads).
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipId  String      @unique
  membership    Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  // Denormalized on purpose: institution-scoped uniqueness of the
  // reg-number + institution-scoped queries avoid the membership hop.
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  universityId  String
  facultyId     String
  faculty       Faculty     @relation(fields: [facultyId], references: [id])
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id])
  year          Int         @default(1)
  gpa           Decimal     @default(0) @db.Decimal(3, 2)
  totalXp       Int         @default(0)
  level         Int         @default(1)

  // ─── master-E1: حقول النمط المدرسي (kind=SCHOOL) ───────────────
  // ثنائية المدرسة/الجامعة: الحقول الجامعية أعلاه (facultyId/
  // departmentId/year/universityId) تبقى كما هي وتُقرأ كنمط جامعي؛
  // هذه الحقول للنمط المدرسي حيث لا كليات ولا أقسام — كلها اختيارية
  // لأن الجامعات لا تستخدمها، والملزِمية تُفرض في طبقة الخدمة حسب
  // kind المؤسسة (لا يمكن NOT NULL هنا دون كسر الصفوف الجامعية).
  stage          String? // المرحلة (ابتدائية/إعدادية/ثانوية)
  grade          String? // الصف (الأول/…/السادس عشر)
  section        String? // الفصل (أ/ب/…)
  previousSchool String? // المدرسة السابقة (نقل/قيد جديد)
  transferStatus String? // حالة النقل (منتقل/مستجد/منسحب…)

  // ─── master-E1: الهوية والتواصل على الملف نفسه ─────────────────
  // مؤسسات بلا بريد إلكتروني (مدارس خصوصًا) تحتاج بياناتها على الملف
  // لا على المستخدم — كلها اختيارية: الاسم على User يبقى مصدر
  // المصادقة، وهذه نسخة الملف (الاسم الرسمي في الوثائق قد يطول).
  nameAr                  String? // الاسم الكامل (عربي) كما في الوثائق
  nameEn                  String? // الاسم الكامل (لاتيني) إن وُجد
  dateOfBirth             DateTime? // تاريخ الميلاد
  profileImageUrl         String? // صورة الملف (مقعد الملف لا المستخدم)
  gender                  Gender?
  city                    String?
  address                 String?
  studentPhone            String? // هاتف الطالب — الصيغة المعروضة
  studentPhoneNormalized  String? // هاتف الطالب — مفتاح البحث (أرقام فقط مع رمز الدولة، انظر src/lib/phones.ts)
  additionalPhone         String? // هاتف إضافي (صيغة معروضة)
  guardianName            String? // اسم ولي الأمر
  guardianRelationship    String? // صلة القرابة (أب/أم/وصي…)
  guardianPhone           String? // هاتف ولي الأمر — المعروض
  guardianPhoneNormalized String? // هاتف ولي الأمر — مفتاح البحث
  emergencyContactName    String? // جهة الاتصال للطوارئ
  emergencyContactPhone   String? // هاتف الطوارئ (معروض)

  // ─── r349-P1: الاسم الرباعي والهوية الوطنية (PROFILES-RESEARCH §2) ──
  // الاسم الكامل كما في الوثائق يبقى nameAr أعلاه؛ هذه الأجزاء
  // المفصولة اختيارية — منظمة، قابلة للاستيراد والبحث، ولا تُلزم أحدًا.
  fatherName      String? // اسم الأب (الاسم الثاني في الرباعي)
  grandfatherName String? // اسم الجد (الاسم الثالث)
  motherName      String? // اسم الأم — كما في الوثائق عند الحاجة
  birthPlace      String? // مكان الميلاد (بلدية/مدينة) — غير مدينة السكن
  // الرقم الوطني: الخام لا يُعاد أبدًا إلا للمالك/OWNER/ADMIN؛ البحث
  // والتطابق (الاستيراد/الدليل) عبر الهاش المطبَّع، والعرض المقنّع
  // من الخام في طبقة الخدمة (maskNationalId).
  nationalId     String? // الرقم الوطني — 12 خانة تبدأ بسنة الميلاد
  nationalIdHash String? // SHA-256(أرقام فقط) — مفتاح المطابقة المفهرس

  // ─── r349-P1: وضع الدراسة والقبول ────────────────────────────────
  studyType                StudyType? // صباحي/مسائي/موازي
  enrollmentStatus        EnrollmentStatus? // مقيّد/موقوف/مؤجّل/… (الغائب = ACTIVE)
  secondarySchool         String? // اسم مدرسة الشهادة الثانوية
  secondarySchoolBranch   String? // الشعبة (علمي/أدبي/…) — نص حر: الفروع تختلف
  secondarySchoolPercent  Decimal? @db.Decimal(5, 2) // نسبة الثانوية المئوية 0-100
  admissionYear           Int? // سنة القبول/التسجيل الأول

  // ─── r349-P1: مصفوفة ظهور الهاتف (الملف يتحكم فيمن يراه) ────────
  studentPhoneVisibility  PhoneVisibility @default(INSTITUTION_STAFF)
  guardianPhoneVisibility PhoneVisibility @default(INSTITUTION_STAFF)

  // master-E1 — قيم الحقول المخصصة المرتبطة بهذا الملف.
  fieldValues FieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // رقم التسجيل الجامعي مُتفرّد لكل مؤسسة — نفس الرقم قد يوجد في
  // مؤسسة أخرى (r178).
  @@unique([institutionId, universityId])
  @@index([userId])
  @@index([institutionId])
  @@index([facultyId])
  @@index([departmentId])
  // master-E1 — البحث بالهاتف المُطبَّع (استعلامات «من هذا الرقم؟»).
  @@index([studentPhoneNormalized])
  // r349-P1 — مطابقة الرقم الوطني عبر الهاش (الاستيراد/الدليل) بلا
  // فهرسة الخام ولا تعريضه في سجلات الاستعلام.
  @@index([nationalIdHash])
}

model TeacherProfile {
  // r178 restructure: per-membership profile with its own cuid PK (the
  // institution is reached through membership — no denormalized column
  // here; teacher queries resolve membership.institutionId).
  id                   String            @id @default(cuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipId         String            @unique
  membership           Membership        @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  specialty            String
  rank                 AcademicRank      @default(LECTURER)
  departmentId         String
  department           Department        @relation("TeacherHomeDepartment", fields: [departmentId], references: [id])
  bio                  String?
  // Onboarding / suitability detection
  degreeLevel          DegreeLevel       @default(MASTERS)
  yearsExperience      Int               @default(0)
  certifications       Json? // [{ title, issuer, year }]
  publications         Json? // [{ title, venue, year, url? }]
  awards               Json? // [{ title, year, issuer? }]
  profileImageUrl      String?
  officeLocation       String? // e.g. "مبنى الكلية - مكتب 305"
  officeHours          String? // e.g. "الأحد والثلاثاء 10-12"
  websiteUrl           String?
  subjectKeywords      String[]          @default([]) // ["AI", "Machine Learning", "Statistics"]
  verifiedAt           DateTime?
  verifiedById         String?
  verifiedBy           User?             @relation("TeacherProfileVerifier", fields: [verifiedById], references: [id])
  // Academic leadership appointment, layered on top of teaching.
  // Nullable: a TeacherProfile without a position is just a regular professor.
  position             AcademicPosition?
  positionFacultyId    String?
  positionFaculty      Faculty?          @relation("FacultyLeadership", fields: [positionFacultyId], references: [id])
  positionDepartmentId String?
  positionDepartment   Department?       @relation("DepartmentLeadership", fields: [positionDepartmentId], references: [id])
  appointedAt          DateTime?
  termEndsAt           DateTime?

  // ─── master-E1: هوية المدرّس وموظفيته (كلها اختيارية) ─────────
  // المدارس والمراكز تخاطب مدرّسيها بالرقم الوظيفي لا بالبريد؛
  // والاسم الرسمي قد يطول عن الاسم القصير على User.
  employeeId              String? // الرقم الوظيفي داخل المؤسسة
  nameAr                  String? // الاسم الكامل (عربي) كما في الوثائق
  nameEn                  String? // الاسم الكامل (لاتيني) إن وُجد
  personalPhone           String? // الهاتف الشخصي — المعروض
  personalPhoneNormalized String? // الهاتف الشخصي — مفتاح البحث (src/lib/phones.ts)
  officialPhone           String? // هاتف المكتب الرسمي
  officialEmail           String? // البريد الرسمي للمؤسسة (مستقل عن بريد الدخول)

  // ─── r349-P1: تفضيلات التواصل وظهور الهاتف الشخصي ────────────────
  preferredContact         PreferredContact? // قناة التواصل المفضلة
  personalPhoneVisibility  PhoneVisibility @default(INSTITUTION_STAFF)

  // master-E1 — قيم الحقول المخصصة المرتبطة بهذا الملف.
  fieldValues FieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([departmentId])
  @@index([verifiedById])
  @@index([positionFacultyId])
  @@index([positionDepartmentId])
  // master-E1 — بحث الرقم الوظيفي (رواتب/حضور/استيراد).
  @@index([employeeId])
}

// ────────────────────────────────────────────────────────────────
//  master-E1 — النظام البنيوي للحقول المخصصة (Custom fields)
// ────────────────────────────────────────────────────────────────
//  كل مؤسسة تُعرّف حقولها الإضافية على ملفات الطلبة/المدرّسين/
//  الموظفين — تعريف مُهيكل (عمود لكل دلالة: نوع، إلزام، خيارات،
//  تحقق، صلاحية رؤية) لا كيس Json على الملف. القيمة تُخزَّن في
//  FieldValue بعمود مطابق لنوع التعريف — قابلة للفهرسة والتحقق
//  المركزي في طبقة الخدمة (validateFieldValue في
//  src/lib/profiles/fields.ts — نقية بلا قاعدة).
//  ثنائية المدرسة/الجامعة: الجامعة تُعرّف «المعدل التراكمي الثانوي»
//  والمدرسة تُعرّف «رقم الحافلة» — نفس الجهاز يخدم الاثنين.

enum FieldEntity {
  STUDENT
  TEACHER
  // STAFF معرَّف مسبقًا لطبقة الموظفين القادمة — لا يوجد نموذج ملف
  // موظف بعد، وFieldValue لا يقبل سوى ملفات الطالب/المدرّس حاليًا
  // (يُفرض في طبقة الخدمة حتى يوجد النموذج).
  STAFF
}

enum FieldType {
  TEXT // نص حر — valueText
  NUMBER // رقم — valueNumber
  DATE // تاريخ — valueDate
  BOOLEAN // نعم/لا — valueBoolean
  SELECT // اختيار واحد من options — valueSelect
  MULTI_SELECT // اختيار متعدد من options — valueMultiSelect
}

// تعريف حقل مخصص — مملوك للمؤسسة. key ثابت (slug) تُبنى عليه
// استعلامات/API الملف؛ والترتيب sortOrder مُتفرّد داخل
// (المؤسسة، الكيان) حتى لا يتزاحم حقلان على مقعد واحد في النموذج.
model InstitutionFieldDefinition {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  key           String // مفتاح ثابت (slug) — «bus-number»
  labelAr       String
  labelEn       String
  entity        FieldEntity
  type          FieldType
  required      Boolean     @default(false)
  // مُتحكَّم به: string[] — خيارات SELECT/MULTI_SELECT (يُصدَّق في
  // الخدمة: مصفوفة نصوص غير خالية بلا تكرار؛ null لبقية الأنواع).
  options       Json?
  // مُتحكَّم به: { min?: number; max?: number; pattern?: string } —
  // للنص: طول/نمط؛ للرقم: حدّان؛ للتاريخ: نطاق زمني (epoch ms).
  // يُصدَّق في الخدمة لا في القاعدة.
  validation    Json?
  // مُتحكَّم به: { roles: Role[] } — من يرى الحقل (قائمة أدوار
  // صالحة من enum Role)؛ null = عام داخل المؤسسة.
  visibleTo     Json?
  searchable    Boolean     @default(false) // يدخل البحث العام للملفات
  importKeyAr   String? // مرادف الترويسة في الاستيراد (عربي)
  importKeyEn   String? // مرادف الترويسة في الاستيراد (لاتيني)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  values FieldValue[]

  @@unique([institutionId, key])
  @@unique([institutionId, entity, sortOrder])
  @@index([institutionId, entity])
}

// قيمة حقل مخصص — صف واحد لكل (تعريف، ملف). أحد مفتاحي الملف
// مُعبَّد والآخر فارغ (يُفرض في طبقة الخدمة — Prisma 5.22 لا يدعم
// CHECK عبر التخطيط)؛ وفهرسا التفرد (definitionId، studentProfileId)
// و(definitionId، teacherProfileId) يضمنان قيمة واحدة للتعريف على
// كل ملف (تعدد NULL مسموح في Postgres — صفوف الكيان الآخر لا
// تتزاحم).
model FieldValue {
  id               String                     @id @default(cuid())
  definitionId     String
  definition       InstitutionFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  studentProfileId String?
  studentProfile   StudentProfile?            @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  teacherProfileId String?
  teacherProfile   TeacherProfile?            @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  // عمود واحد مطابق لنوع التعريف يُملأ (يُفرض في الخدمة):
  valueText        String? // TEXT
  valueNumber      Decimal? // NUMBER
  valueDate        DateTime? // DATE
  valueBoolean     Boolean? // BOOLEAN
  valueSelect      String? // SELECT — قيمة من options التعريف
  valueMultiSelect String[]  @default([]) // MULTI_SELECT — قيم من options

  @@unique([definitionId, studentProfileId])
  @@unique([definitionId, teacherProfileId])
  @@index([studentProfileId])
  @@index([teacherProfileId])
}

// ────────────────────────────────────────────────────────────────
//  master-F1 — نظام الاستيراد/الترحيل (Import jobs)
// ────────────────────────────────────────────────────────────────
//  تطوّر مسار CSV القديم (r323 B3.1 — /users/bulk-import الذي يبقى
//  كما هو) إلى نظام ترحيل كامل: ملفات CSV/XLSX، تخطيط أعمدة قابل
//  للحفظ وإعادة الاستخدام، تحقق صفًّا صفًّا بلا قاعدة، ثم تنفيذ
//  مجزَّأ (chunks) بمعاملات صغيرة — لا معاملة عملاقة أبدًا (قانون
//  المهمة). الطبقة النقية في src/lib/import/*؛ هذه النماذج هي
//  حالات الاستيراد فقط (سجل الوظيفة + صفوفها + مخططات الأعمدة).

// صيغة الملف المصدر. XLSX يُقرأ عبر exceljs (الورقة الأولى)، وCSV
// عبر محلّل RFC 4180 نفسه الذي يستخدمه مسار r323.
enum ImportFormat {
  CSV
  XLSX
}

// دورة حياة وظيفة الاستيراد: رفع ← تخطيط ← تحقق ← تنفيذ ← إتمام.
// FAILED تعني فشلًا وظيفيًا (مثل ملف غير قابل للقراءة)؛ الصفوف
// الفاشلة داخل تنفيذ ناجح تبقى في صفوف الوظيفة (ImportRow) ولا
// تُفشل الوظيفة كلها. CANCELLED مقبض إداري مستقبلي.
enum ImportJobStatus {
  UPLOADED
  MAPPED
  VALIDATED
  COMMITTING
  COMPLETED
  FAILED
  CANCELLED
}

// حالة صف المصدر الواحد: PENDING عند الإنشاء، ثم حكم التحقق
// (OK/ERROR)، ثم نتيجة التنفيذ (OK مع resultRef، أو SKIPPED بسياسة
// التكرار، أو ERROR برسالة عربية).
enum ImportRowStatus {
  PENDING
  OK
  SKIPPED
  ERROR
}

// وظيفة استيراد واحدة — مملوكة للمؤسسة. columnMap يحمل
// MappingProfile {version, columns:[{source,target}]} القابل
// للتسلسل والحفظ، وsummary يحمل العدادات وتقرير التكرار، وerror
// سبب الفشل الوظيفي إن وُجد. idempotencyKey يسمح للعميل إعادة
// إرسال نفس الطلب دون إنشاء وظيفة مكررة.
model ImportJob {
  id              String          @id @default(cuid())
  institutionId   String
  institution     Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User            @relation("ImportJobCreator", fields: [createdByUserId], references: [id])
  entity          FieldEntity // STUDENT | TEACHER (STAFF يُرفض في طبقة الخدمة — لا نموذج ملف موظف بعد)
  fileName        String
  format          ImportFormat
  status          ImportJobStatus @default(UPLOADED)
  totalRows       Int
  processedRows   Int             @default(0)
  succeededRows   Int             @default(0)
  skippedRows     Int             @default(0)
  failedRows      Int             @default(0)
  columnMap       Json? // MappingProfile — {version: 1, columns: [{source, target}]}
  summary         Json? // {counts, duplicateReport, warnings, emailPlaceholder…}
  error           Json? // {messageAr, at} — الفشل الوظيفي فقط
  idempotencyKey  String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  rows ImportRow[]

  @@index([institutionId, status])
  @@index([createdByUserId, createdAt])
}

// صف مصدر واحد داخل وظيفة — rawData الخلايا كما وردت، mappedData
// الحقول المخطَّطة، errorAr رسالة الرفض العربية، resultRef معرّف
// الملف/الحساب الناتج (idempotency: التنفيذ مجددًا يتخطى ما له
// resultRef).
model ImportRow {
  id         String          @id @default(cuid())
  jobId      String
  job        ImportJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  line       Int // 1-based — رقم صف البيانات (بعد الترويسة)
  status     ImportRowStatus @default(PENDING)
  rawData    Json // string[] — خلايا الصف كما وردت في الملف
  mappedData Json? // الحقول المخطَّطة + القيم المُطبَّعة
  errorAr    String? // رسالة الرفض/الفشل العربية (بلا فاصلة، صف واحد)
  resultRef  String? // معرّف StudentProfile/TeacherProfile الناتج (أو الموجود عند SKIP)

  @@unique([jobId, line])
  @@index([jobId, status])
}

// مخطط أعمدة محفوظ باسم — يستعيده المسجّل في الملف القادم بدل
// إعادة المطابقة يدويًا. profile يحمل MappingProfile نفسه، والتفرد
// (institutionId, name) يمنع التسمية المزدوجة داخل المؤسسة.
model ImportMappingProfile {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  entity        FieldEntity
  profile       Json // MappingProfile — {version: 1, columns: [{source, target}]}
  createdById   String
  createdBy     User        @relation("ImportMappingProfileCreator", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([institutionId, name])
  @@index([institutionId, entity])
}

// ────────────────────────────────────────────────────────────────
//  Academic structure
// ────────────────────────────────────────────────────────────────
model Faculty {
  id                 String             @id @default(cuid())
  // The same faculty name can exist in multiple cities (e.g. "كلية الاقتصاد"
  // in two cities are distinct campuses). Since r178 the institution
  // carries the scoping — uniqueness is on (institutionId, name, city).
  name               String
  nameEn             String?
  iconEmoji          String?
  // City the faculty is located in. r178: no column default — the
  // institution now carries the scoping and new faculties are created
  // with an explicit city.
  city               String
  institutionId      String
  institution        Institution        @relation(fields: [institutionId], references: [id])
  createdAt          DateTime           @default(now())
  departments        Department[]
  students           StudentProfile[]
  questionCategories QuestionCategory[]
  examTemplates      ExamTemplate[]
  // Reverse relations for governance scoping (ADR — sub-project A)
  scopedAdmins       User[]             @relation("FacultyScopedAdmins")
  leadership         TeacherProfile[]   @relation("FacultyLeadership")

  // r323 B3.1
  inviteCodes InviteCode[]

  @@unique([institutionId, name, city])
  @@index([city])
  @@index([institutionId])
}

model Department {
  id                 String             @id @default(cuid())
  name               String
  nameEn             String?
  facultyId          String
  faculty            Faculty            @relation(fields: [facultyId], references: [id])
  courses            Course[]
  students           StudentProfile[]
  teachers           TeacherProfile[]   @relation("TeacherHomeDepartment")
  createdAt          DateTime           @default(now())
  questionCategories QuestionCategory[]
  // Reverse relation for department-head appointments
  leadership         TeacherProfile[]   @relation("DepartmentLeadership")

  // r323 B3.1
  inviteCodes InviteCode[]

  @@unique([facultyId, name])
  @@index([facultyId])
}

model Course {
  id            String             @id @default(cuid())
  code          String
  name          String
  nameEn        String?
  description   String?
  credits       Int                @default(3)
  iconEmoji     String?
  themeColor    String?
  // r178: denormalized from department.faculty.institutionId — derived
  // and validated by app code on every create/update (app-level
  // invariant) so course codes stay unique per institution.
  institutionId String
  institution   Institution        @relation(fields: [institutionId], references: [id])
  departmentId  String
  department    Department         @relation(fields: [departmentId], references: [id])
  offerings     CourseOffering[]
  concepts      KnowledgeConcept[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([departmentId])
}

model CourseOffering {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  teacherId String
  teacher   User     @relation("TeacherOfferings", fields: [teacherId], references: [id])
  term      String // e.g. "2024-FALL"
  room      String?
  capacity  Int      @default(40)
  createdAt DateTime @default(now())

  enrollments    Enrollment[]
  schedule       ScheduleSlot[]
  materials      Material[]
  assignments    Assignment[]
  attendance     AttendanceSession[]
  grades         Grade[]
  lectures       Lecture[]
  researchPapers ResearchPaper[]
  examTemplates  ExamTemplate[]
  liveSessions   LiveSession[]

  // r323 B3.1
  inviteCodes InviteCode[]

  @@unique([courseId, term, teacherId])
  @@index([teacherId])
  @@index([term])
}

model Enrollment {
  id          String         @id @default(cuid())
  studentId   String
  student     User           @relation("StudentEnrollments", fields: [studentId], references: [id])
  offeringId  String
  offering    CourseOffering @relation(fields: [offeringId], references: [id])
  status      String         @default("active")
  progressPct Int            @default(0)
  enrolledAt  DateTime       @default(now())

  @@unique([studentId, offeringId])
  @@index([offeringId])
}

model ScheduleSlot {
  id         String         @id @default(cuid())
  offeringId String
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0=Sunday … 6=Saturday (Arabic week starts Sunday)
  startTime  String // "08:00"
  endTime    String // "09:30"
  room       String?

  @@index([offeringId])
}

// ────────────────────────────────────────────────────────────────
//  Materials & uploads
// ────────────────────────────────────────────────────────────────
model Material {
  id          String         @id @default(cuid())
  offeringId  String
  offering    CourseOffering @relation(fields: [offeringId], references: [id])
  uploaderId  String
  uploader    User           @relation("MaterialUploader", fields: [uploaderId], references: [id])
  name        String
  description String?
  type        MaterialType
  sizeBytes   BigInt         @default(0)
  url         String
  views       Int            @default(0)
  downloads   Int            @default(0)
  createdAt   DateTime       @default(now())

  @@index([offeringId])
  @@index([type])
  @@index([uploaderId])
}

// ────────────────────────────────────────────────────────────────
//  Assignments & submissions
// ────────────────────────────────────────────────────────────────
model Assignment {
  id          String         @id @default(cuid())
  offeringId  String
  offering    CourseOffering @relation(fields: [offeringId], references: [id])
  title       String
  description String?
  type        AssignmentType
  dueAt       DateTime
  weight      Int            @default(10)
  maxScore    Int            @default(100)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  submissions Submission[]

  @@index([offeringId])
  @@index([dueAt])
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      User             @relation(fields: [studentId], references: [id])
  fileUrl      String?
  textAnswer   String?
  status       SubmissionStatus @default(SUBMITTED)
  grade        Decimal?         @db.Decimal(5, 2)
  feedback     String?
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

// ────────────────────────────────────────────────────────────────
//  Grades & attendance
// ────────────────────────────────────────────────────────────────
model Grade {
  id         String         @id @default(cuid())
  offeringId String
  offering   CourseOffering @relation(fields: [offeringId], references: [id])
  studentId  String
  student    User           @relation("StudentGrades", fields: [studentId], references: [id])
  kind       GradeKind
  score      Decimal        @db.Decimal(5, 2)
  maxScore   Int            @default(100)
  weight     Int            @default(10)
  feedback   String?
  recordedAt DateTime       @default(now())

  @@unique([offeringId, studentId, kind])
  @@index([studentId])
}

model AttendanceSession {
  id         String             @id @default(cuid())
  offeringId String
  offering   CourseOffering     @relation(fields: [offeringId], references: [id])
  date       DateTime
  topic      String?
  records    AttendanceRecord[]
  createdAt  DateTime           @default(now())

  @@unique([offeringId, date])
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User              @relation(fields: [studentId], references: [id])
  status    AttendanceStatus
  notes     String?

  @@unique([sessionId, studentId])
  @@index([studentId])
}

// ────────────────────────────────────────────────────────────────
//  Notifications & messaging
// ────────────────────────────────────────────────────────────────
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  icon      String?
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  // r146 (T1-c F5): the notifications list (GET /me/notifications — the
  // most-polled route) sorts by createdAt desc per user; (userId, readAt)
  // serves only the unread counter — this turns the sort into an index
  // range scan instead of a sort step.
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Message {
  id         String    @id @default(cuid())
  fromUserId String
  fromUser   User      @relation("MessageSender", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User      @relation("MessageReceiver", fields: [toUserId], references: [id])
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([toUserId, readAt])
  @@index([fromUserId])
}

// ────────────────────────────────────────────────────────────────
//  Social: posts, comments, study rooms
// ────────────────────────────────────────────────────────────────
model Post {
  id            String      @id @default(cuid())
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  body          String
  hashtags      String[]
  imageUrl      String?
  createdAt     DateTime    @default(now())

  comments  PostComment[]
  reactions PostReaction[]

  @@index([authorId])
  @@index([createdAt])
  // r179 (phase-5): the community feed is institution-scoped — the
  // feed query filters (institutionId, createdAt desc).
  @@index([institutionId, createdAt])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([authorId])
}

model PostReaction {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id])
  kind   String // "like" | "save"

  @@unique([postId, userId, kind])
  @@index([userId])
}

model StudyRoom {
  id            String            @id @default(cuid())
  name          String
  topic         String?
  ownerId       String
  owner         User              @relation("StudyRoomOwner", fields: [ownerId], references: [id])
  institutionId String
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  members       StudyRoomMember[]

