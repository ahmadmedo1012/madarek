  @@index([categoryId])
  @@index([authorId])
  @@index([difficulty])
  @@index([isApproved])
  @@index([moderatedById])
}

model ExamTemplate {
  id             String          @id @default(cuid())
  offeringId     String?
  offering       CourseOffering? @relation(fields: [offeringId], references: [id])
  facultyId      String? // faculty-wide unified exam
  faculty        Faculty?        @relation(fields: [facultyId], references: [id])
  title          String
  kind           ExamKind        @default(QUIZ)
  description    String?         @db.Text
  durationMin    Int             @default(45)
  passingScore   Int             @default(50)
  randomized     Boolean         @default(true)
  status         ExamStatus      @default(DRAFT)
  authorId       String
  author         User            @relation("ExamAuthor", fields: [authorId], references: [id])
  moderatedById  String?
  moderatedBy    User?           @relation("ExamModerator", fields: [moderatedById], references: [id])
  moderationNote String?
  openAt         DateTime?
  closeAt        DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  questions ExamTemplateQuestion[]
  attempts  ExamAttempt[]

  @@index([offeringId])
  @@index([facultyId])
  @@index([authorId])
  @@index([status])
  @@index([moderatedById])
}

model ExamTemplateQuestion {
  id             String       @id @default(cuid())
  templateId     String
  template       ExamTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question     @relation(fields: [questionId], references: [id])
  order          Int
  pointsOverride Int? // override the question's default points

  @@unique([templateId, questionId])
  @@unique([templateId, order])
  @@index([questionId])
}

model ExamAttempt {
  id          String        @id @default(cuid())
  templateId  String
  template    ExamTemplate  @relation(fields: [templateId], references: [id])
  studentId   String
  student     User          @relation(fields: [studentId], references: [id])
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  expiresAt   DateTime
  status      AttemptStatus @default(IN_PROGRESS)
  score       Decimal?      @db.Decimal(6, 2)
  maxScore    Decimal       @db.Decimal(6, 2)

  answers ExamAnswer[]

  @@index([templateId])
  @@index([studentId])
  // r146 (T1-c F4): the standalone [status] index is dropped — fully
  // covered by the [status, expiresAt] prefix (same redundant-prefix
  // class the 20260924050000 orphan-index round removed); one less
  // btree write per exam attempt.
  @@index([status, expiresAt])
}

model ExamAnswer {
  id            String      @id @default(cuid())
  attemptId     String
  attempt       ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id])
  // Student input — interpreted per question type
  answerText    String?     @db.Text
  choiceIndex   Int?
  isCorrect     Boolean? // null = pending manual review
  awardedPoints Decimal?    @db.Decimal(6, 2)
  feedback      String?
  answeredAt    DateTime    @default(now())

  @@unique([attemptId, questionId])
  @@index([questionId])
}

