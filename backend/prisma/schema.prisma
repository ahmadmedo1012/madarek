// ────────────────────────────────────────────────────────────────
//  Virtual labs & AR/VR
// ────────────────────────────────────────────────────────────────
model VirtualLab {
  id               String       @id @default(cuid())
  name             String
  platform         String? // "Cisco Packet Tracer", "Arduino Sim"…
  category         String
  iconEmoji        String?
  totalExperiments Int          @default(0)
