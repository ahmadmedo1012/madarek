# ════════════════════════════════════════════════════════════════
# Frontend env (Vite)
# ════════════════════════════════════════════════════════════════
# In single-service production deployment the frontend is served by
# the same Express server as the API, so the API base URL is just
# `/api/v1` (relative). The default below already does that.
#
# Override only when running the Vite dev server against a different
# API host (e.g. local backend on :4000, frontend on :5173).
# ────────────────────────────────────────────────────────────────

# Local dev (Vite proxy already forwards /api → :4000, so leaving this
# unset is fine. Set it explicitly if you bypass the proxy.)
# VITE_API_BASE_URL=http://localhost:4000/api/v1

VITE_APP_NAME="مدارك AI"
