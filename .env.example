# ════════════════════════════════════════════════════════════════
# Madarek AI — Environment Variables (template)
# ════════════════════════════════════════════════════════════════
# Copy this file to `backend/.env` for local development.
# In production (Render), set these in the service dashboard.
# Never commit real secrets to git.
# ─────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database (Neon Postgres) ─────────────────────────────────────
# Create a project on https://neon.tech, copy the "pooler" connection string.
# This single URL works for both runtime queries and `prisma migrate`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require"

# Optional: only set this if your provider differentiates pooled vs direct
# connections AND you hit migration issues with the pooled URL above.
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DBNAME?sslmode=require"

# ── JWT ──────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="replace-me-with-64-bytes-of-random-hex"
JWT_REFRESH_SECRET="replace-me-with-a-DIFFERENT-64-bytes-of-random-hex"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── CORS ─────────────────────────────────────────────────────────
# Same-origin in production (single Render service), but we keep the
# allow-list for the local Vite dev server (5173) and any external clients.
CORS_ORIGINS=http://localhost:5173

# ── Cookies ──────────────────────────────────────────────────────
COOKIE_DOMAIN=
# Auto: false in dev, true in production. Override only if you know why.
# COOKIE_SECURE=false

# ── Single-service mode ─────────────────────────────────────────
# When true, Express serves the built React app from `frontend/dist`
# alongside the API. Auto-true in production.
# SERVE_STATIC=false

# ── Rate limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
