# Required environment for backend/.env (local dev) and Render dashboard (prod)
DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require&channel_binding=require"

# Generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-64-bytes-of-random-hex"
JWT_REFRESH_SECRET="replace-with-a-DIFFERENT-64-bytes-of-random-hex"

# --- Optional ---
# Comma-separated extra allowed CORS origins. CAUTION: when set, this list
# REPLACES the default allow-list entirely (it does not append) — include
# your production origin explicitly. The default when unset/empty:
# "https://madarek.onrender.com,http://localhost:5173". No wildcards —
# credentials are enabled.
# CORS_ORIGINS="https://madarek.onrender.com,https://custom-domain.example"

# Shared secret for internal service-to-service routes (e.g. milestone firing).
# Compared using SHA-256 + timingSafeEqual; requests fail closed when unset.
# INTERNAL_SERVICE_TOKEN="generate-another-random-hex-string"

# --- File storage (PDF uploads) ---
# STORAGE_DRIVER selects where uploaded PDFs live (backend/src/lib/storage.ts):
#   local (default) — filesystem under STORAGE_DIR. Fine for dev; on Render the
#   disk is EPHEMERAL: uploaded files vanish on every redeploy/restart.
#   s3 — any S3-compatible object store (AWS S3, Cloudflare R2, MinIO) for
#   real persistence. Selecting s3 requires the four S3_* vars below (env.ts
#   fails boot naming exactly what is missing); S3_REGION defaults to 'auto'
#   (the R2 convention).
# STORAGE_DRIVER=local
# Absolute root for the local driver (default: backend/storage).
# STORAGE_DIR=backend/storage
# Service endpoint, path-style addressing. R2 example shape:
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ENDPOINT=https://replace-with-your-s3-or-r2-endpoint
# S3_REGION=auto
# S3_BUCKET=replace-with-your-bucket-name
# S3_ACCESS_KEY_ID=replace-with-your-access-key
# S3_SECRET_ACCESS_KEY=replace-with-your-secret-key

# --- AI provider (chat assistant) ---
# AI_PROVIDER selects the reply engine (backend/src/lib/ai.ts):
#   local (default) — replies are composed in-process from mastery-aware
#   templates. Zero cost, zero external calls, token counters stay 0.
#   openai — a real OpenAI-compatible LLM (OpenAI, Groq, OpenRouter,
#   DeepSeek, vLLM, Ollama...). Replies come from the model, with the
#   conversation's recent turns and the student's mastery context in the
#   system prompt; telemetry records the real model + token usage.
#   Selecting openai requires AI_API_KEY + AI_MODEL (env.ts fails boot
#   naming exactly what is missing).
# AI_PROVIDER=local
# Base URL of an OpenAI-compatible API. Keep the version suffix — the
# client appends /chat/completions. Defaults to OpenAI:
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=replace-with-your-provider-key
# AI_MODEL=replace-with-your-model-name

# --- Test accounts (R320 §C) ---
# Set to 1 to ensure the documented easy-login test accounts (one per
# job, @test.ly / 12345678 — the single source of truth is
# shared/testAccounts.ts, physically backend/src/modules/auth/
# test-accounts.data.ts) on every backend BOOT: idempotent upserts that
# create-or-reset ONLY these accounts (password, activation, lockout
# state, profiles). Non-fatal on error (logged, boot continues).
# NOTE FOR RENDER: set MADAREK_TEST_ACCOUNTS=1 in the Render dashboard
# (Environment) — repo files cannot set service env vars. Deploy-time
# `npm run db:seed` also ensures the accounts on every deploy
# (the one deliberate exception to the r183 established-DB zero-writes
# rule), so the boot flag is a self-healing belt on top of that.
# MADAREK_TEST_ACCOUNTS=1
